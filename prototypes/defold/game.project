[project]
title = Microgen Defold
version = 1.5.6

[bootstrap]
main_collection = /main/gameplay.collectionc

[display]
width = 2460
height = 1080
window_width = 1230
window_height = 540
vsync = 1
swap_interval = 1
variable_dt = 1
dynamic_orientation = 0

[input]
game_binding = /main/arena.input_bindingc

[android]
immersive_mode = 1
package = org.magral.microgen.defold
version_code = 156
minimum_sdk_version = 26
