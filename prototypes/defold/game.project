[project]
title = Microgen Defold
version = 1.5.9

[bootstrap]
main_collection = /main/gameplay.collectionc

[display]
width = 2460
height = 1080
window_width = 1230
window_height = 540
vsync = 1
swap_interval = 1
variable_dt = 1
dynamic_orientation = 0

[input]
game_binding = /main/arena.input_bindingc

[android]
immersive_mode = 1
package = org.magral.microgen.defold
version_code = 159
app_icon_36x36 = /assets/app_icons/microgen_36.png
app_icon_48x48 = /assets/app_icons/microgen_48.png
app_icon_72x72 = /assets/app_icons/microgen_72.png
app_icon_96x96 = /assets/app_icons/microgen_96.png
app_icon_144x144 = /assets/app_icons/microgen_144.png
app_icon_192x192 = /assets/app_icons/microgen_192.png
minimum_sdk_version = 26
