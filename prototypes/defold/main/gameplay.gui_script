local WIDTH, HEIGHT = Interface.width, Interface.height
local App = {}
App.__index = App
local DIRECTIONS = {[hash("up")]="up",[hash("down")]="down",[hash("left")]="left",[hash("right")]="right"}

local function bounded_direction(dx,dy,r)
    local length = math.sqrt(dx*dx+dy*dy)
    if length<=.0001 then return 0,0 end
    local strength = math.min(1,length/r)
    return dx*strength/length,dy*strength/length
end

-- Keep the complete joystick artwork visible inside the platform safe area.
-- The touch origin remains unchanged and is still used for movement direction.
local function touch_zones()
    local window_width,window_height=window.get_size()
    local scene_width,scene_height=gui.get_width(),gui.get_height()
    local left,right,top,bottom=ScreenLayout.safe_bounds(
        window_width,window_height,scene_width,scene_height,window.get_safe_area(),42,33)
    return left,right,top,bottom
end

-- Let an unoccupied touch move the organism anywhere in the active playfield.
-- UI hit targets take priority so right-side buttons remain clickable.
local function can_start_movement(screen,press_action,x,left,right)
    return screen=="run" and not press_action and x>=left and x<=right
end

local function stick_visual_origin(x,y)
    local window_width,window_height=window.get_size()
    local scene_width,scene_height=gui.get_width(),gui.get_height()
    local left,right,top,bottom=ScreenLayout.safe_bounds(
        window_width,window_height,scene_width,scene_height,window.get_safe_area(),42,33)
    local margin=90 -- 86-unit base radius plus the tip's maximum 57+32-unit reach.
    local function clamp_axis(value,low,high)
        local minimum,maximum=low+margin,high-margin
        if minimum>maximum then return (low+high)/2 end
        return math.max(minimum,math.min(maximum,value))
    end
    return clamp_axis(x,left,right),clamp_axis(y,bottom,top)
end

local function has_checkpoint(profile)
    return type(profile.checkpoint)=="table" and next(profile.checkpoint)~=nil
end

local function name(id)
    local entry = Catalog.item(id)
    return entry and entry.name or tostring(id)
end

function App:notice(message)
    if type(message)=="string" and #message>0 then
        gui.set_text(self.toast,message)
        self.toast_time=4.2
    end
end

function App:clear_pointer()
    self.touch_id,self.stick,self.press_action = nil,nil,nil
    self.keys={}
    gui.set_enabled(self.stick_base,false)
    gui.set_enabled(self.stick_tip,false)
end

function App:overlay(kind)
    self:clear_pointer()
    self.modal:clear()
    self.modal:fit_safe_area()
    self.scene:set_labels_visible(kind == "run")
    if self.fixed then self.fixed:visible(kind == "run") end
    if kind ~= "run" then
        self.hud:visible(false)
        self.toast_time=0
        gui.set_text(self.toast,"")
    end
    self.screen=kind
    self.close_current=nil
end

local function family_profile(store,id)
    if id==store:family_id() then return store.profile end
    for _,family in ipairs(store.profile.families.items) do
        if family.id==id then return family.state end
    end
end

local function family_recipe(profile,form)
    local checkpoint=profile and profile.checkpoint or {}
    if Genome.validate(checkpoint.player_genome) then return checkpoint.player_genome end
    if profile then return Heredity.recipe(Legacy.loadout(profile)) end
    local recipe=Genome.create(14481,0,"player",0)
    recipe.family=({predator=1,toxic=0,colony=4})[form] or 1
    if form=="toxic" then recipe.tissue=2 end
    return recipe
end

local function portrait(ui,x,y,radius,recipe)
    local art=BodyArt[recipe.family+1]
    local body=ui:image("cells","body_"..recipe.family,x,y,art[1]*radius/108,art[2]*radius/108)
    gui.set_color(body,Interface.color(Genome.colors(recipe)[1]))
    return body
end

local HOME_SLOTS = 3

function App:show_home()
    self:overlay("home")
    self.audio:stop()
    self.sim=nil
    self.hud:clear()
    self.metrics=nil
    if not self.home_world then self.home_world=Simulation.new(14481) end
    self.scene:render(self.home_world)
    gui.set_enabled(self.cover,false)
    local ui=self.modal
    ui:box(1230,540,2460,1080,vmath.vector4(.006,.027,.043,.35))
    local families=self.store:family_summaries()
    local total,by_slot=HOME_SLOTS,{}
    local active_slot
    for i,family in ipairs(families) do
        local slot=family.slot or i
        by_slot[slot]=family
        total=math.max(total,slot)
        if family.id==self.store:family_id() then active_slot=slot end
    end
    local page=self.home_slot or active_slot
    page=math.min(total,page or 1)
    self.home_slot=page
    local family=by_slot[page]
    local function select_slot(slot)
        self.home_slot=slot
        self:show_home()
    end
    ui:text(1230,1011,"МИКРОГЕН",2.08,ui.colors.pale,nil,true)
    local first_slot=math.max(1,page-HOME_SLOTS+1)
    for i=1,HOME_SLOTS do
        local slot=first_slot+i-1
        local occupant=by_slot[slot]
        local form=occupant and Legacy.FORMS[occupant.form]
        ui:button(1230+(i-2)*591,898,566,78,
            ("%d · %s"):format(slot,form and form.name or (occupant and "Организм" or "Пусто")),
            function() select_slot(slot) end,slot==page,1.15)
    end
    local frame=ui:surface(1230,524,1818,610,"panel")
    gui.set_color(frame,vmath.vector4(.71,1,1,.90))
    local function slot_arrow(x,direction)
        local slot=page+direction
        local enabled=slot>=1 and slot<=total
        ui:button(x,524,136,285,"",enabled and function() select_slot(slot) end or nil)
        local shade=enabled and ui.colors.pale or Interface.color("496972")
        for _,side in ipairs({-1,1}) do
            local stroke=ui:box(x-direction*4,524+side*16,48,9,shade)
            gui.set_rotation(stroke,vmath.vector3(0,0,-side*direction*45))
        end
    end
    slot_arrow(227,-1)
    slot_arrow(2233,1)

    local function new()
        if #families<HOME_SLOTS then self:new_family(not family and page<=HOME_SLOTS and page or nil) else self:show_families() end
    end
    if family then
        local profile=family_profile(self.store,family.id)
        local form=Legacy.FORMS[profile.legacy.selected_form] or Legacy.FORMS[family.form]
        local recipe=family_recipe(profile,family.form)
        local family_state=Equipment.from_profile(profile)
        local build_data=Equipment.aggregate(family_state)
        local build=Build.new()
        build.organs,build.qualities,build.specializations=build_data.organs,build_data.qualities,build_data.specializations
        local radius=184
        local glow=ui:image("cells","surge",708,528,540,540)
        gui.set_color(glow,vmath.vector4(.31,.91,.75,.24))
        portrait(ui,708,528,radius,recipe)
        local anatomy=Anatomy.new(ui.group)
        ui:remember(anatomy.node)
        local preview={player={x=0,y=0},player_genome=recipe,build=build,facing=0,elapsed=0,
            enemies={},pickups={},remains={},effects={},hp=100,max_hp=100,
            body_radius=function() return radius end,body_color=function() return Genome.colors(recipe)[1] end}
        Anatomy.update(anatomy,preview,708,528,radius)
        for _,node in ipairs(anatomy.ribbons) do ui:remember(node) end
        ui:fit_text(1110,748,form.name.." амёба",1.78,ui.colors.pale,940,82)
        ui:fit_text(1110,655,form.desc,1.06,ui.colors.pale,940,80)
        local stage=profile.checkpoint.stage_index or 1
        ui:fit_text(1110,566,("%s · Поколение %d · Ступень %d"):format(family.name,family.generation,stage),.99,ui.colors.dim,940,63)
        ui:button(1578,445,936,113,family.alive and "Продолжить" or "Подготовить",function()
            if not self.store:select_family(family.id) then return self:notice(self.store.last_error) end
            self.equipment_state=nil
            self.body_page,self.stock_page=1,1
            if family.alive then self:start() else self:body(false) end
        end,true,1.53)
        ui:button(1578,313,936,90,#families<HOME_SLOTS and "Новый организм" or "Управление слотами",new,false,1.16)
    else
        local glow=ui:image("cells","surge",708,528,440,440)
        gui.set_color(glow,vmath.vector4(.35,.83,.79,.34))
        ui:text(708,528,"+",2.0,ui.colors.dim,nil,true)
        ui:text(1110,705,"Свободный слот",1.5,ui.colors.pale)
        ui:text(1110,619,"Выбери форму для нового забега.",1,ui.colors.dim)
        ui:button(1550,490,880,106,"Новый организм",new,true,1.20)
    end
    local buttons={
        {"Семьи",function() self:show_families() end},
        {"Геном",function() Panels.legacy(self) end},
        {"Кодекс",function() Panels.catalog(self) end},
        {"Помощь",function() self:help() end},
        {self.updater.state=="ready" and "Обновить игру" or "Обновления",function() self:updates() end},
        {"Выход",function() sys.exit(0) end},
    }
    for i,button in ipairs(buttons) do
        ui:button(1230+(i-3.5)*382,116,362,112,button[1],button[2],false,1.10)
    end
end

function App:show_families()
    self:overlay("families")
    self.close_current=function() self:show_home() end
    self.audio:stop()
    self.sim=nil
    self.hud:clear()
    self.metrics=nil
    if not self.home_world then self.home_world=Simulation.new(14481) end
    self.scene:render(self.home_world)
    gui.set_enabled(self.cover,false)
    local ui = self.modal
    ui:box(1230,540,2460,1080,vmath.vector4(.015,.035,.05,.65))
    ui:widen(1681)
    local groups={alive={},ancestral={}}
    for _,family in ipairs(self.store:family_summaries()) do
        local list=groups[family.alive and "alive" or "ancestral"]
        list[#list+1]=family
    end
    self.family_pages=self.family_pages or {}
    local populated=#groups.alive+#groups.ancestral>0
    local card_height=populated and 550 or 470
    local lower=(1080-(card_height+245))/2
    local upper=lower+card_height+175
    ui:text(1230,upper+25,"МИКРОГЕН · Семьи",1.25,ui.colors.mint,nil,true)
    local function family_group(group,x,heading,empty)
        local list=groups[group]
        local index=math.min(math.max(1,self.family_pages[group] or 1),math.max(1,#list))
        local y=lower+126+card_height/2
        local top=y+card_height/2
        local family=list[index]
        ui:surface(x,y,829,card_height)
        ui:text(x-389,top-43,heading,1,ui.colors.mint)
        if family then
            local profile=family_profile(self.store,family.id)
            local current_form=Legacy.FORMS[profile.legacy.selected_form] or Legacy.FORMS[family.form]
            portrait(ui,x-275,top-192,77,family_recipe(profile,family.form))
            ui:text(x-155,top-103,family.name,1,ui.colors.mint)
            ui:text(x-155,top-150,current_form.name.." форма",.83,ui.colors.dim)
            ui:text(x-155,top-195,("Поколение %d · жизни %d"):format(family.generation,family.runs),.83,ui.colors.dim)
            ui:text(x-155,top-239,("Ядра %d · рекорд %d с"):format(family.cores,math.floor(family.best)),.83,ui.colors.dim)
            ui:text(x-155,top-280,family.best_stage>0 and ("Пройдена ступень · "..family.best_stage) or "Лестница ещё не пройдена",.83,Interface.color("cdb5e8"))
            local status=family.alive and "Жизнь сохранена · один наследник" or (family.ended and "Жизнь завершена · новый наследник" or "Готова к первой жизни · сохранения нет")
            ui:text(x-389,top-337,status,.83,ui.colors.dim)
            ui:button(x-195,top-406,379,75,family.alive and "Продолжить" or "Подготовить",function()
                if not self.store:select_family(family.id) then return self:notice(self.store.last_error) end
                self.equipment_state=nil
                self.body_page,self.stock_page=1,1
                if family.alive then self:start() else self:body(false) end
            end,true,.83)
            ui:button(x+195,top-406,379,75,"Удалить…",function() self:delete_family(family) end,false,.83)
        else
            ui:text(x-389,y,empty,.83,ui.colors.dim,760)
        end
        local function move(delta)
            return function()
                self.family_pages[group]=index+delta
                self:show_families()
            end
        end
        local pager=y-card_height/2+58
        ui:button(x-311,pager,156,75,"НАЗАД",index>1 and move(-1) or nil,false,.83)
        ui:text(x,pager,("%d / %d"):format(family and index or 0,#list),.83,ui.colors.dim,nil,true)
        ui:button(x+311,pager,156,75,"ДАЛЕЕ",index<#list and move(1) or nil,false,.83)
    end
    family_group("alive",804,"Живые организмы","Нет живых организмов.\nСоздайте новую семью.")
    family_group("ancestral",1656,"Семьи · подготовка","Здесь появятся семьи\nдля следующего поколения.")
    ui:button(1230,lower+76,1680,75,"Главное меню",function() self:show_home() end,true,.83)
    local buttons={
        {"Геном",function() Panels.legacy(self) end},
        {"Кодекс",function() Panels.catalog(self) end},
        {"Помощь",function() self:help() end},
        {self.updater.state=="ready" and "Обновить игру" or "Обновления",function() self:updates() end},
        {"Выход",function() sys.exit(0) end},
    }
    for i,button in ipairs(buttons) do ui:button(1230+(i-3)*340,lower-14,319,75,button[1],button[2],false,.83) end
    ui:text(1230,lower-79,"Версия "..sys.get_config_string("project.version","0.3.0").." · игра без интернета",.83,ui.colors.pale,nil,true)
end

function App:new_family(slot)
    if #self.store.profile.families.items>=HOME_SLOTS then return self:show_families() end
    self:overlay("new_family")
    local ui=self.modal
    local left=ui:panel("Новое семейство","Выбери стартовую форму и боевой орган.",function() self:show_home() end,1960)
    ui:text(left+33,842,"Форма задаёт тело и мягкое предпочтение органов.",.83,ui.colors.dim)
    for i,id in ipairs(Legacy.FORM_IDS) do
        local data=Legacy.FORMS[id]
        local x=1230+(i-2)*529
        local accent=id=="predator" and Interface.color("f5b47c")
            or id=="toxic" and Interface.color("a6e274") or Interface.color("8ad8ef")
        ui:surface(x,526,523,590,"panel")
        ui:surface(x,526,511,578,"card")
        ui:box(x,796,451,5,accent)
        local glow=ui:image("cells","surge",x,646,342,342)
        gui.set_color(glow,vmath.vector4(accent.x,accent.y,accent.z,.16))
        local recipe=family_recipe(nil,id)
        portrait(ui,x,645,120,recipe)
        local build=Build.new()
        build.organs[data.organ]=1
        local anatomy=Anatomy.new(ui.group)
        ui:remember(anatomy.node)
        local preview={player={x=0,y=0},player_genome=recipe,build=build,facing=0,elapsed=0,
            enemies={},pickups={},remains={},effects={},hp=100,max_hp=100,
            body_radius=function() return 120 end,body_color=function() return Genome.colors(recipe)[1] end}
        Anatomy.update(anatomy,preview,ui:layout_x(x),645,120)
        for _,node in ipairs(anatomy.ribbons) do ui:remember(node) end
        ui:surface(x,439,350,42,"button")
        ui:text(x,439,string.upper(data.name).." ФОРМА",.72,accent,nil,true)
        ui:image("icons","icon_"..data.organ,x-176,377,58,58)
        ui:fit_text(x-130,377,"СТАРТОВЫЙ ОРГАН · "..name(data.organ),.76,ui.colors.pale,304,48)
        ui:fit_text(x-228,324,data.desc,.76,ui.colors.dim,452,74)
        ui:button(x,270,455,76,"Выбрать форму",function()
            local generated_name="Семейство "..self.store.profile.families.next_id
            if not self.store:create_family(generated_name,id,slot) then return self:notice(self.store.last_error) end
            self.home_slot=nil
            self.equipment_state=nil
            self.body_page,self.stock_page=1,1
            self:body(false)
        end,true,.88)
    end
    ui:button(1230,183,1584,75,"Назад",function() self:show_home() end,false,.83)
end

function App:delete_family(family)
    self:overlay("family_delete")
    local ui=self.modal
    local left=ui:panel("Удалить "..family.name.."?","Удалятся сохранённая жизнь, органы, материалы и наследие только этого семейства.",
        function() self:show_home() end,1275)
    ui:text(left+33,807,"Другие семейства сохранятся. Это действие нельзя отменить.",1,ui.colors.pale,1200)
    ui:button(923,696,570,84,"Оставить",function() self:show_home() end,true)
    ui:button(1537,696,570,84,"Удалить семейство",function()
        if not self.store:delete_family(family.id) then return self:notice(self.store.last_error) end
        self.home_slot=nil
        self:show_home()
    end)
end

function App:help()
    self:overlay("help")
    local ui=self.modal
    local left=ui:panel("Как выжить в капле","Движение — единственное действие во время боя.",function() self:show_home() end,1275)
    local tips={
        "Коснись любого свободного места экрана и веди палец: появится джойстик.",
        "На ПК: WASD или стрелки. M — карта, E — колония, B — развитие, Esc — пауза.",
        "Зелёные фрагменты ДНК повышают уровень. Биомасса нужна для покупок и переброса мутаций. Органиум дают за боссов, минибоссов и завершение забега.",
        "Касание захватывает пищу: можно плыть дальше, пока она переваривается. Рецепторы открывают притягивание. Бирюзовые кусочки лечат.",
        "Рост меняет соотношение сил: бывшие хищники становятся пищей. У босса после залпа открывается ядро.",
        "Собирай пары органов: щупальца + кислота, шипы + импульс, деление + след, заражение + пасть.",
        "Посети гнёзда и победи местных минибоссов, чтобы открыть маршрут к боссу ступени.",
        "Игра сохраняет забег при паузе и уходе в фон. В меню можно продолжить сохранённую жизнь.",
    }
    for i,tip in ipairs(tips) do ui:text(left+33,820-(i-1)*84,"• "..tip,.83,Interface.color("b8d0cd"),1209) end
    ui:button(1230,135,1209,84,"Понятно",function() self:show_home() end,true)
end

function App:updates()
    self:overlay("updates")
    local ui, updater = self.modal, self.updater
    local function back() self:show_home() end
    local left = ui:panel("Обновления Микрогена", "Загрузка идёт в фоне. Установку подтверждает Android.", back)
    local label = updater.asset and updater.asset.label or ""
    local captions = {
        idle = "Игра проверяет новые версии Defold автоматически.",
        checking = "Проверяем выпуски на GitHub…",
        downloading = "Загружаем и проверяем версию " .. label .. "…",
        ready = updater.needs_permission and "Разреши установку из этого приложения в настройках Android."
            or "Версия " .. label .. " готова к установке.",
        current = "У тебя актуальная стабильная версия Defold.",
        error = "Обновиться не удалось. Можно повторить проверку.",
        desktop = "Для Android доступна версия " .. label .. ".",
    }
    ui:text(left+33,828,"Установлена версия "..updater.installed,1)
    ui:text(left+33,754,captions[updater.state],.96,ui.colors.dim)
    if updater.state == "ready" then
        ui:button(1230,646,1479,84,"Открыть установщик",function() updater:install() end,true)
        if updater.needs_permission then
            ui:button(1230,545,1479,84,"Разрешение Android",function() updater.native.allow() end)
        end
    elseif updater.state ~= "checking" and updater.state ~= "downloading" then
        ui:button(1230,646,1479,84,"Проверить обновления",function() updater:check() end,true)
    end
    if not updater.needs_permission then
        ui:button(1230,545,1479,84,"Открыть выпуски на GitHub",function()
            sys.open_url("https://github.com/Magral/Microgen/releases")
        end)
    end
    ui:button(1230,447,1479,84,"Назад",back)
end

local function part_caption(part)
    return string.format("%s · Р%d · %d кл.",name(part.kind),part.rank,part.cells)
end

function App:leave_body(live)
    if not live then return self:show_home() end
    if self.sim.stage_transition then return self:stage_transition() end
    if self.development_origin=="pause" then return self:pause() end
    self:show_run()
end

function App:body(live)
    self:overlay(live and "build" or "preparation")
    local profile,ui=self.store.profile,self.modal
    local state=Equipment.from_profile(profile)
    if not state.equipped then
        self:notice("Не удалось прочитать органы семейства")
        return self:leave_body(live)
    end
    self.hud:visible(false)
    local family_name="Организм"
    for _,family in ipairs(self.store:family_summaries()) do
        if family.id==self.store:family_id() then family_name=family.name;break end
    end
    local close=function() self:leave_body(live) end
    self.close_current=close
    local form=Legacy.FORMS[state.form]
    local left=ui:panel("Организм",("%s · %s"):format(family_name,form.name),close,2220)
    local used=Slots.used_cells(state)
    local materials=profile.organ_materials or {}
    ui:text(left+33,859,("Тело %d/%d · Органиум %d · Органеллы %d · Мембраны %d · Плазма %d"):format(
        used,state.body_capacity,profile.organium or 0,materials.organelle or 0,materials.membrane or 0,materials.plasma or 0),.80,ui.colors.dim)

    local organs_x, synergies_x=left+365,left+1855
    for _,x in ipairs({organs_x,1230,synergies_x}) do ui:surface(x,570,660,505,"card") end
    ui:text(organs_x,779,"Органы",1.08,ui.colors.pale,nil,true)
    ui:text(synergies_x,779,"Синергии",1.08,ui.colors.pale,nil,true)
    ui:box(organs_x,750,580,3,ui.colors.mint)
    ui:box(synergies_x,750,580,3,ui.colors.mint)

    local function open(part,location)
        return function() self:equipment(part,location,1,live,nil,function() self:body(live) end) end
    end
    local body_pages=math.max(1,math.ceil(#state.equipped/3))
    self.body_page=math.min(self.body_page or 1,body_pages)
    local offset=(self.body_page-1)*3
    local selected
    for i=1,3 do
        local part=state.equipped[offset+i]
        if part and part.id==self.body_selected then selected=part end
    end
    selected=selected or state.equipped[offset+1]
    for i=1,3 do
        local part=state.equipped[offset+i]
        if not part then break end
        local y=686-(i-1)*79
        local current=selected==part
        ui:button(organs_x,y,598,72,"",function()
            self.body_selected=part.id
            self.body_synergy_page=1
            self:body(live)
        end,current)
        ui:image("icons","icon_"..part.kind,organs_x-245,y,55,55)
        ui:fit_text(organs_x-204,y,name(part.kind),1,current and Interface.color("09272c") or ui.colors.pale,390,57)
        ui:text(organs_x+245,y,tostring(part.rank),1.03,current and Interface.color("09272c") or ui.colors.mint,nil,true)
    end
    ui:button(organs_x-149,443,282,64,"Свойства",selected and open(selected,"equipped"),false,.9)
    ui:button(organs_x+149,443,282,64,"+ Добавить",used<state.body_capacity and function()
        self:inventory(1,live,"stock","body")
    end or nil,false,.9)
    local function pager(x,page,total,change)
        if total<=1 then return end
        ui:button(x-178,365,106,58,"НАЗАД",page>1 and function() change(page-1) end or nil)
        ui:text(x,365,page.." / "..total,.85,ui.colors.dim,nil,true)
        ui:button(x+178,365,106,58,"ДАЛЕЕ",page<total and function() change(page+1) end or nil)
    end
    pager(organs_x,self.body_page,body_pages,function(page)
        self.body_page=page
        self.body_synergy_page=1
        self:body(live)
    end)

    local recipe=live and self.sim.player_genome or family_recipe(profile,state.form)
    local build=live and self.sim.build or Build.new()
    if not live then StageRewards.apply_equipment(state,build) end
    local color=live and self.sim:body_color() or Genome.colors(recipe)[1]
    local facing=live and self.sim.facing or 0
    local body=portrait(ui,1230,592,112,recipe)
    gui.set_color(body,Interface.color(color))
    gui.set_rotation(body,vmath.vector3(0,0,-math.deg(facing)))
    local anatomy=Anatomy.new(ui.group)
    ui:remember(anatomy.node)
    local preview={player_genome=recipe,build=build,facing=facing,elapsed=1,
        enemies={},pickups={},remains={},effects={},hp=1,max_hp=1,
        body_radius=function() return 112 end,body_color=function() return color end}
    Anatomy.update(anatomy,preview,1230,592,112)
    if selected then
        local spotlight=Anatomy.new(ui.group)
        ui:remember(spotlight.node)
        local kind=selected.kind
        preview.build={
            rank=function(_,id) return id==kind and build:rank(id) or 0 end,
            quality=function(_,id) return build:quality(id) end,
            evolved=function(_,id) return id==kind and build:evolved(id) end,
        }
        Anatomy.update(spotlight,preview,1230,592,112)
        gui.set_color(spotlight.node,vmath.vector4(1.25,1.25,1.25,.78))
        ui:image("icons","icon_"..kind,1005,388,50,50)
        ui:fit_text(1048,388,name(kind),.92,ui.colors.mint,394,62)
    end

    local rows=Inspector.synergy_rows(build,selected and selected.kind)
    local pages=math.max(1,math.ceil(#rows/3))
    self.body_synergy_page=math.min(self.body_synergy_page or 1,pages)
    for i=1,3 do
        local row=rows[(self.body_synergy_page-1)*3+i]
        if not row then break end
        local y=678-(i-1)*104
        ui:surface(synergies_x,y,598,94,row.related and "button" or "card")
        if row.related then ui:box(synergies_x-282,y,5,66,ui.colors.mint) end
        ui:fit_text(synergies_x-263,y+22,row.name,.92,ui.colors.pale,524,38)
        ui:fit_text(synergies_x-263,y-18,row.status,.82,row.active and ui.colors.mint or Interface.color("c4aeea"),524,42)
    end
    pager(synergies_x,self.body_synergy_page,pages,function(page)
        self.body_synergy_page=page
        self:body(live)
    end)
    ui:text(left+33,300,("Запас %d/%d мест"):format(#state.stock,state.stock_capacity),.83,ui.colors.dim)
    local stock_pages=math.max(1,math.ceil(state.stock_capacity/3))
    self.stock_page=math.min(self.stock_page or 1,stock_pages)
    local shown=math.min(3,state.stock_capacity-(self.stock_page-1)*3)
    local stock_width=(1904-(shown-1)*14)/math.max(1,shown)
    for i=1,shown do
        local index=(self.stock_page-1)*3+i
        local part=state.stock[index]
        local x=left+282+stock_width/2+(i-1)*(stock_width+14)
        ui:button(x,300,stock_width,68,part and part_caption(part) or ("+ Запас "..index),
            part and open(part,"stock") or function() self:stock_sources(live) end,false,.82)
    end
    if stock_pages>1 then
        ui:button(1030,213,122,63,"НАЗАД",self.stock_page>1 and function() self.stock_page=self.stock_page-1;self:body(live) end or nil)
        ui:text(1230,213,self.stock_page.." / "..stock_pages,.83,ui.colors.dim,nil,true)
        ui:button(1430,213,122,63,"ДАЛЕЕ",self.stock_page<stock_pages and function() self.stock_page=self.stock_page+1;self:body(live) end or nil)
    end
    local actions={
        {"Назад",close},
        {"Геном",function() Panels.legacy(self,nil,nil,function() self:body(live) end) end},
        {"Сводка",function() self:build(1,"journal",live) end},
    }
    if live then actions[#actions+1]={"Мутации",function() self:build(1,"temporary",true) end} end
    if not live then
        actions[#actions+1]={"Архив",function() self:inventory(1,false,"reserve") end}
        actions[#actions+1]={"Облик",function()
            if self.store:reroll_morphology() then self:body(false) else self:notice(self.store.last_error) end
        end}
        actions[#actions+1]={"Начать жизнь",function() self:start() end,true}
    end
    local w=(2154-(#actions-1)*17)/#actions
    for i,action in ipairs(actions) do
        ui:button(left+33+w/2+(i-1)*(w+17),127,w,75,action[1],action[2],action[3],.83)
    end
end

function App:stock_sources(live)
    self:overlay("inventory")
    local ui=self.modal
    local close=function() self:body(live) end
    ui:panel("Заполнить запас","Выбери, откуда взять орган.",close,1275)
    ui:button(1230,797,1209,84,"Из тела",function() self:inventory(1,live,"equipped","stock") end)
    ui:button(1230,695,1209,84,"Из архива семейства",function() self:inventory(1,live,"reserve","stock_from_archive") end)
    ui:button(1230,593,1209,84,"К организму",close)
end

function App:inventory(page,live,group,target)
    self:overlay("inventory")
    local ui=self.modal
    local state=Equipment.from_profile(self.store.profile)
    local rows={}
    local locations={equipped="В теле",stock="В запасе",reserve="В архиве"}
    local leave=function() self:body(live) end
    local reopen=function() self:inventory(page,live,group,target) end
    for _,location in ipairs(group and {group} or {"equipped","stock","reserve"}) do
        for _,part in ipairs(state[location] or {}) do
            rows[#rows+1]={title=name(part.kind),icon=part.kind,
                meta=("РАНГ %d · %d ЯЧ."):format(part.rank,part.cells),detail=locations[location],
                label="Открыть",action=function() self:equipment(part,location,page,live,target,reopen) end}
        end
    end
    local heading=({reserve="Архив семейства",stock="Запас органов",equipped="Органы в теле"})[group] or "Органы"
    local detail=group=="reserve" and "Выбери сохранённый орган." or "Выбери орган для перестройки."
    Panels.list(ui,heading,detail,rows,page,function(next_page) self:inventory(next_page,live,group,target) end,leave)
end

function App:equipment(organ,location,page,live,target,return_to,tab)
    self:overlay("organ_detail")
    local ui = self.modal
    local leave = return_to or function() self:inventory(page,live) end
    self.close_current=leave
    local left=ui:panel(name(organ.kind),"Свойства принадлежат этому экземпляру и сохраняются в семействе.",leave,1650)
    tab=tab or "stats"
    local function change(action,...)
        local profile = self.store.profile
        local state = Equipment.from_profile(profile)
        local result
        if action=="move" then result=Equipment.move(state,organ.id,...)
        elseif action=="upgrade" then result=Equipment.upgrade(state,organ.id,profile.organium,profile.organ_materials)
        elseif action=="dismantle" then result=Equipment.dismantle(state,organ.id,profile.organium,profile.organ_materials)
        else result=Equipment.specialize(state,organ.id,...)
        end
        if not result or not result.ok then
            self:notice(result and result.error or "Изменение не удалось")
            return false
        end
        local next_profile = Copy(profile)
        next_profile.organism = result.state
        next_profile.organium = result.organium or profile.organium
        next_profile.organ_materials = result.materials or profile.organ_materials
        if live or has_checkpoint(profile) then
            local snapshot=live and self.sim:snapshot() or Copy(profile.checkpoint)
            local Build=require "main.run.build_model"
            local candidate=Build.new()
            candidate:from_dict(snapshot.build)
            StageRewards.apply_equipment(result.state,candidate)
            snapshot.build=candidate:to_dict()
            snapshot.stock_capacity=result.state.stock_capacity
            next_profile.checkpoint=snapshot
        end
        if not self.store:write_profile(next_profile) then self:notice(self.store.last_error);return false end
        if live then
            StageRewards.apply_equipment(result.state,self.sim.build)
            self.sim.stock_capacity=result.state.stock_capacity
        end
        leave()
        return true
    end
    local detail=function(section) self:equipment(organ,location,page,live,target,leave,section) end
    local function equip()
        if change("move","body") then return end
        local state=Equipment.from_profile(self.store.profile)
        local selected={}
        local function choose(next_page)
            ui:clear()
            local rows={}
            local cells=Slots.used_cells(state)+organ.cells
            for _,part in ipairs(state.equipped) do
                if selected[part.id] then cells=cells-part.cells end
                rows[#rows+1]={title=(selected[part.id] and "ВЫБРАНО · " or "")..part_caption(part),icon=part.kind,
                    label=selected[part.id] and "Оставить" or "Заменить",action=function()
                    selected[part.id]=not selected[part.id]
                    choose(next_page)
                end}
            end
            Panels.list(ui,"Перестройка",("Обмен · тело %d → %d/%d кл."):format(Slots.used_cells(state),cells,state.body_capacity),
                rows,next_page,choose,function() detail(tab) end)
            ui:button(1230,114,285,63,"Применить",cells<=state.body_capacity and function()
                local ids={}
                for _,part in ipairs(state.equipped) do if selected[part.id] then ids[#ids+1]=part.id end end
                change("move","body",ids)
            end or nil,true,.88)
        end
        choose(1)
    end
    ui:image("icons","icon_"..organ.kind,left+183,613,255,255)
    local locations={equipped="В теле",stock="В запасе",reserve="В архиве"}
    ui:text(left+365,825,part_caption(organ).." · "..locations[location],.95,ui.colors.mint)
    for i,item in ipairs({{"Показатели","stats"},{"Синергии","synergies"},{"Рост","growth"},{"Специализация","specialization"}}) do
        ui:button(left+480+(i-1)*329,751,313,72,item[1],tab~=item[2] and function() detail(item[2]) end or nil,false,.83)
    end
    if tab=="synergies" then
        local build=live and self.sim.build or require("main.run.build_model").new()
        if not live then StageRewards.apply_equipment(Equipment.from_profile(self.store.profile),build) end
        ui:text(left+332,582,Inspector.synergy_summary(build,organ.kind),.88,ui.colors.mint,1260)
    elseif tab=="growth" then
        local cost=Equipment.upgrade_cost(organ)
        ui:text(left+332,638,("Следующий ранг · %d органиума + %d органелл"):format(cost,Equipment.upgrade_ingredient(organ)),.88)
        ui:button(left+619,548,574,75,("Улучшить · ранг %d → %d"):format(organ.rank,organ.rank+1),function() change("upgrade") end,true,.87)
    elseif tab=="specialization" then
        local profile=self.store.profile
        local active=Catalog.specialization_data(organ.kind,organ.specialization or "")
        ui:text(left+332,655,"Активная ветвь: "..(active.name or "Нет"),.9,ui.colors.mint)
        for i,option in ipairs(Catalog.SPECIALIZATIONS[organ.kind] or {}) do
            local y=606-(i-1)*141
            ui:text(left+332,y,option.name,.86,Interface.color(option.color))
            ui:text(left+332,y-55,option.desc,.76,ui.colors.dim,890)
            ui:button(left+1450,y-16,328,65,option.id==organ.specialization and "Активна" or "Выбрать",option.id~=organ.specialization and function()
                change("specialize",option.id,profile.organium,profile.organ_materials)
            end or nil,true,.83)
        end
    else
        ui:text(left+332,622,Catalog.effect_text(organ.kind,organ.rank),.95,ui.colors.mint,1250)
        ui:text(left+332,535,Catalog.item(organ.kind).desc,.87,ui.colors.pale,1250)
    end
    local actions={
        {"Назад",leave},
        {"Кодекс",function() Panels.catalog(self,"organs",1,function() detail(tab) end,organ.kind) end},
        {"Расщепить",function()
            self:overlay("organ_detail")
            self.close_current=function() detail(tab) end
            ui:panel("Расщепить орган?","Ранг и орган будут потеряны.",function() detail(tab) end,1275)
            ui:button(927,723,578,84,"Оставить",function() detail(tab) end,true)
            ui:button(1533,723,578,84,"Расщепить",function() change("dismantle") end)
        end},
    }
    if location~="equipped" then actions[#actions+1]={"В тело",equip,true} end
    if location=="equipped" or location=="reserve" then
        local destination=location=="equipped" and "stock" or "stock_from_archive"
        actions[#actions+1]={"В запас",function() change("move",target or destination) end}
    else
        actions[#actions+1]={"В архив",function() change("move","archive") end}
    end
    local w=(2154-(#actions-1)*17)/#actions
    for i,action in ipairs(actions) do
        ui:button(left+33+w/2+(i-1)*(w+17),127,w,75,action[1],action[2],action[3],.83)
    end
end

function App:save_run()
    local sim = self.sim
    if not sim then return true end
    local profile = Copy(self.store.profile)
    local snapshot = sim:snapshot()
    local source = self.equipment_state
    if source then profile.organism=source end
    local state,err = StageRewards.capture_equipment(profile,snapshot.build)
    if not state then self:notice(err);return false end
    profile.organism,profile.checkpoint=state,snapshot
    local discovered={}
    for _,id in ipairs(profile.discovered) do discovered[id]=true end
    for _,ids in ipairs({Catalog.ORGAN_IDS,Catalog.ADAPTATION_IDS}) do
        for _,id in ipairs(ids) do
            if sim.build:rank(id)>0 and not discovered[id] then profile.discovered[#profile.discovered+1]=id end
        end
    end
    local synergy_known={}
    for _,id in ipairs(profile.synergies) do synergy_known[id]=true end
    for _,id in ipairs(sim.build:active_synergies()) do
        if not synergy_known[id] then profile.synergies[#profile.synergies+1]=id end
    end
    local result=self.store:write_profile(profile)
    if result then self.equipment_state=nil else self:notice(self.store.last_error) end
    return result
end

function App:start(seed)
    if self.store:family_id()=="" then
        if not self.store:create_family("Организм","predator") then return self:notice(self.store.last_error) end
    end
    local profile = self.store.profile
    if has_checkpoint(profile) then
        self.sim = Simulation.restore(profile.checkpoint)
        if not self.sim then return self:notice("Не удалось открыть сохранение") end
    else
        if not Legacy.can_start(profile) then
            Panels.legacy(self,"imprint",1)
            return self:notice("Выбери отпечаток, чтобы открыть новое поколение")
        end
        seed = seed or math.floor(socket.gettime()*1000)%2147483647
        local loadout = Legacy.loadout(profile)
        self.sim = Simulation.new(seed,profile.unlocked,profile.upgrades,loadout.branch,loadout)
        self.sim.family_id = self.store:family_id()
        self.sim.best_stage = profile.best_stage or 0
        local equipment = Equipment.from_profile(profile)
        StageRewards.apply_equipment(equipment,self.sim.build)
        self.sim.stock_capacity = equipment.stock_capacity
    end
    self.save_time=0
    self.equipment_state=nil
    self:show_run()
    self:save_run()
    self:notice("Веди палец по свободной части экрана")
    print("MICROGEN RUN READY " .. tostring(self.sim.world.seed_value))
end

local function safe_edges()
    local window_width,window_height=window.get_size()
    local area=window.get_safe_area()
    local scene_width,scene_height=gui.get_width(),gui.get_height()
    local _,right,top,bottom=ScreenLayout.safe_bounds(
        window_width,window_height,scene_width,scene_height,area,42,33)
    -- The gameplay vitals panel is intentionally edge-anchored. Its own text
    -- and meters retain their 23-unit inner padding; other controls still
    -- respect the platform safe area on the right and vertically.
    return 0,right,top,bottom
end

function App:show_run()
    self:overlay("run")
    gui.set_enabled(self.cover,false)
    local ui=self.hud
    ui:clear()
    local left,right,top,bottom=safe_edges()
    local control_x=right-144
    local color=Interface.color
    local width=720
    self.hud_left,self.hud_top=left,top
    self.vitals=ui:surface(left+380,top-200,760,400,"panel")
    self.stage=ui:text(left+23,top-32,"",.80,ui.colors.pale,width)
    self.level=ui:text(left+23,top-76,"",.82,ui.colors.pale,width)
    self.health=ui:meter(left+23,top-105,width,12,color("78d9bd"))
    self.shield_metric=ui:text(left+23,top-136,"",.80,color("b5d5ff"),width)
    self.shield,self.shield_base=ui:meter(left+23,top-163,width,10,color("8ebcf4"))
    self.area=ui:text(left+23,top-192,"",.81,ui.colors.pale,width)
    self.xp,self.xp_base=ui:meter(left+23,top-220,width,10,color("ba99e4"))
    self.biomass=ui:text(left+23,top-250,"",.77,ui.colors.dim,width)
    self.goal=ui:text(left+23,top-279,"",.77,ui.colors.gold,width)
    self.last_damage=ui:text(left+23,top-326,"",.77,ui.colors.red,width)
    self.metrics=ui:fit_text(left+10,bottom+16,"000 FPS · P95 ≤ 000.0 мс",.73,
        color("a5d6ce"),math.max(240,right-360),40)
    self.hud_has_barrier=nil
    if not self.minimap then self.minimap=Minimap.new(self.sim.world) end
    ui:surface(right-442,top-97,204,194,"panel")
    local mini=ui:box(right-442,top-97,182,176,vmath.vector4(1,1,1,1))
    self.minimap:attach(mini)
    ui:button(control_x,top-46,288,80,"Карта",function() self:map() end)
    ui:button(control_x,top-144,288,80,"Организм",function()
        self.development_origin=nil
        self:body(true)
    end)
    ui:button(control_x,bottom+47,288,75,"Ⅱ  Пауза",function() self:pause() end)
    self.reward_x,self.reward_y=control_x,top-250
    self.reward_button=false
    self.colony_label=ui:button(1230,bottom+83,420,81,"Войти в колонию",function()
        local index=self.sim:nearby_colony()
        if index>0 then self:colony(index) end
    end,true)
    self:draw_hud()
end

function App:draw_hud()
    local sim=self.sim
    local health=math.min(1,math.max(0,sim.hp/math.max(1,sim.max_hp)))
    local xp=math.min(1,math.max(0,sim.xp/sim:xp_needed()))
    gui.set_size(self.health,vmath.vector3(math.max(.01,720*health),12,0))
    gui.set_size(self.xp,vmath.vector3(math.max(.01,720*xp),10,0))
    gui.set_text(self.stage,("Ступень %d · %s"):format(sim.stage_index,sim:stage_name()))
    gui.set_text(self.level,("Здоровье  %.0f / %.0f"):format(sim.hp,sim.max_hp))
    gui.set_text(self.area,("Уровень %d · ДНК %.0f%%"):format(sim.level,xp*100))
    local elapsed=sim.elapsed
    gui.set_text(self.biomass,("Биомасса %d · ×%.1f · %d:%02d"):format(
        sim.build.biomass,sim:body_radius()/22,math.floor(elapsed/60),math.floor(elapsed)%60))
    local nests=0
    for _,nest in ipairs(sim.world.nests) do if nest.used then nests=nests+1 end end
    local miniboss_target=sim:stage_miniboss_target()
    local goal=sim.boss_spawned and sim:boss_title()
        or ("Гнёзда %d/%d · минибоссы %d/%d"):format(nests,math.min(4,miniboss_target*2),sim.minibosses_defeated or 0,miniboss_target)
    gui.set_text(self.goal,sim.stage_transition and "" or goal)
    local barrier=sim.build:rank("barrier")>0
    if self.hud_has_barrier~=barrier then
        self.hud_has_barrier=barrier
        gui.set_enabled(self.shield,barrier)
        gui.set_enabled(self.shield_base,barrier)
        gui.set_enabled(self.shield_metric,barrier)
        local lift=barrier and 0 or 60
        local left,top=self.hud_left,self.hud_top
        gui.set_position(self.area,vmath.vector3(left+23,top-192+lift,0))
        gui.set_position(self.xp,vmath.vector3(left+23,top-220+lift,0))
        gui.set_position(self.xp_base,vmath.vector3(left+383,top-220+lift,0))
        gui.set_position(self.biomass,vmath.vector3(left+23,top-250+lift,0))
        gui.set_position(self.goal,vmath.vector3(left+23,top-279+lift,0))
        gui.set_position(self.last_damage,vmath.vector3(left+23,top-326+lift,0))
        gui.set_position(self.vitals,vmath.vector3(left+380,top-200+lift/2,0))
        gui.set_size(self.vitals,vmath.vector3(760,400-lift,0))
    end
    if barrier then
        local cooldown=sim.cooldowns.barrier or 0
        gui.set_text(self.shield_metric,cooldown<=0 and ("Щит готов · до %.0f урона"):format(sim:barrier_capacity())
            or ("Щит · восстановление %.1f с"):format(cooldown))
        gui.set_size(self.shield,vmath.vector3(math.max(.01,720*(1-math.min(1,cooldown/8))),10,0))
    end
    self.minimap:update(sim)
    Interface.button_enabled(self.colony_label,sim:nearby_colony()>0)
    local damage=sim.last_damage or {}
    gui.set_text(self.last_damage,damage.name and string.format("Урон: −%.1f HP · %s",damage.amount or 0,damage.name) or "")
end

function App:pause()
    local ui,sim=self.modal,self.sim
    self:overlay("pause")
    local back=function() self:show_run() end
    self.close_current=back
    self:save_run()
    ui:panel("Пауза","Мир замер · прогресс сохранён",back,1960)
    local function toggle(key)
        local profile=Copy(self.store.profile)
        profile[key]=not self[key]
        if self.store:write_profile(profile) then self[key]=profile[key]
        else self:notice(self.store.last_error) end
        self:pause()
    end

    ui:surface(834,499,884,768,"card")
    ui:box(834,872,820,4,Interface.color("4edbb9"))
    ui:text(475,804,("СТУПЕНЬ %d · %s"):format(sim.stage_index,sim:stage_name()),.78,ui.colors.mint,700)
    ui:text(475,738,("УРОВЕНЬ %d · %d:%02d · БИОМАССА %d"):format(
        sim.level,math.floor(sim.elapsed/60),math.floor(sim.elapsed)%60,sim.build.biomass),.76,ui.colors.dim,700)
    ui:text(475,669,("ЗДОРОВЬЕ  %.0f / %.0f"):format(sim.hp,sim.max_hp),.80,ui.colors.pale,700)
    ui:box(834,637,718,14,Interface.color("193540"))
    ui:box(475+math.max(3,718*sim.hp/math.max(1,sim.max_hp))/2,637,
        math.max(3,718*sim.hp/math.max(1,sim.max_hp)),10,Interface.color("62d9b1"))
    if sim.build:rank("barrier")>0 then
        local ready=(sim.cooldowns.barrier or 0)<=0
        ui:text(475,593,ready and ("ЩИТ ГОТОВ · ДО %.0f УРОНА"):format(sim:barrier_capacity())
            or ("ЩИТ ВОССТАНАВЛИВАЕТСЯ · %.1f С"):format(sim.cooldowns.barrier),
            .74,Interface.color("a8d5ff"),700)
        ui:box(834,562,718,10,Interface.color("223c5a"))
        ui:box(475+math.max(3,718*(ready and 1 or 1-math.min(1,sim.cooldowns.barrier/8)))/2,562,
            math.max(3,718*(ready and 1 or 1-math.min(1,sim.cooldowns.barrier/8))),7,
            Interface.color("83b9ff"))
    else
        ui:text(475,593,"ЩИТ НЕ УСТАНОВЛЕН",.74,ui.colors.dim,700)
    end

    ui:button(834,475,718,82,"Продолжить забег",back,true,1.08)
    ui:button(637,368,330,70,"Организм",function()
        self.development_origin="pause"
        self:body(true)
    end,false,.93)
    ui:button(1031,368,330,70,"Карта",function() self:map(true) end,false,.93)
    ui:button(637,275,330,70,self.audio_enabled and "Звук · включён" or "Звук · выключен",
        function() toggle("audio_enabled") end,false,.82)
    ui:button(1031,275,330,70,self.show_metrics and "FPS · включён" or "FPS · выключен",
        function() toggle("show_metrics") end,false,.82)
    ui:button(834,174,718,68,"Сохранить и выйти",function()
        if self:save_run() then self.sim=nil;self:show_home() end
    end,false,.91)

    ui:surface(1705,499,786,768,"card")
    local glow=ui:image("cells","surge",1705,552,520,520)
    gui.set_color(glow,vmath.vector4(.30,.90,.73,.15))
    local recipe=sim.player_genome
    local art=BodyArt[recipe.family+1]
    local body=ui:image("cells","body_"..recipe.family,1705,560,art[1]*1.40,art[2]*1.40)
    gui.set_color(body,Interface.color(sim:body_color()))
    local anatomy=Anatomy.new(ui.group)
    ui:remember(anatomy.node)
    local preview={player=sim.player,player_genome=recipe,build=sim.build,facing=sim.facing,elapsed=sim.elapsed,
        enemies={},pickups={},remains={},effects={},hp=sim.hp,max_hp=sim.max_hp,
        body_radius=function() return 152 end,body_color=function() return sim:body_color() end,
        spore_charge=sim.spore_charge or 0}
    Anatomy.update(anatomy,preview,ui:layout_x(1705),560,152,1,nil,sim.elapsed)
    for _,node in ipairs(anatomy.ribbons) do ui:remember(node) end
    ui:text(1705,211,"ОРГАНИЗМ · ЗЕРНО "..tostring(sim.world.seed_value),.78,ui.colors.dim,nil,true)
end

function App:map(from_pause)
    self:overlay("map")
    local leave=from_pause and function() self:pause() end or function() self:show_run() end
    self.close_current=leave
    local function set_zoom(value)
        self.map_zoom=value
        self:map(from_pause)
    end
    local function locate()
        self.map_zoom=1
        self:map(from_pause)
    end
    MapView.screen(self.modal,self.sim,leave,self.map_zoom,set_zoom,locate)
end

function App:build(page,tab,live)
    if live==nil then live=self.sim~=nil end
    local ui,sim=self.modal,self.sim
    if not live then
        local loadout=Legacy.loadout(self.store.profile)
        sim=Simulation.new(loadout.seed,self.store.profile.unlocked,self.store.profile.upgrades,loadout.branch,loadout)
        StageRewards.apply_equipment(Equipment.from_profile(self.store.profile),sim.build)
    end
    tab = tab or "organs"
    self:overlay("build")
    local rows = {}
    local heading
    if tab=="synergies" then
        for _,data in ipairs(Inspector.synergy_rows(sim.build)) do
            rows[#rows+1] = {title=data.title,meta=data.active and "СИНЕРГИЯ АКТИВНА" or "НУЖНА ПАРА ОРГАНОВ",
                extra=data.active and "Эффект действует" or "Собери пару органов",extra_color=data.active and ui.colors.mint or ui.colors.dim,
                detail=data.requirements,badge=data.active and "+" or "?",
                color=data.active and ui.colors.mint or ui.colors.pale,action=function()
                    self:overlay("build")
                    local left=ui:panel(data.title,data.requirements,function() self:build(page,tab,live) end)
                    ui:text(left+64,580,data.description,1.02,ui.colors.pale,1430)
                end}
        end
    elseif tab=="temporary" then
        heading="Действуют в текущей жизни"
        for _,id in ipairs(Catalog.TEMP_MUTATION_IDS) do
            local rank=sim.build:temporary_mutation_rank(id)
            if rank>0 then
                local mutation=Catalog.TEMP_MUTATIONS[id]
                rows[#rows+1]={title=mutation.name,meta="РАНГ "..rank,detail=mutation.summary}
            end
        end
    elseif tab=="journal" then
        local journal=CombatStats.journal(sim.combat_stats,sim.elapsed)
        heading=journal.summary
        for _,row in ipairs(journal.sources) do rows[#rows+1]=row end
        for _,row in ipairs(journal.history) do rows[#rows+1]=row end
    else
        local ids = tab=="organs" and Catalog.ORGAN_IDS or Catalog.ADAPTATION_IDS
        for _,id in ipairs(ids) do
            local rank=sim.build:rank(id)
            if rank>0 then rows[#rows+1]={title=name(id),icon=id,meta="РАНГ "..rank,
                extra="Качество · "..Rewards.quality_name(sim.build:quality(id)),
                detail=Inspector.effect_text(sim.build,id,sim:ability_scale(),sim:cooldown_factor())} end
        end
    end
    local back=function() self:body(live) end
    self.close_current=back
    Panels.list(ui,"Сводка организма",heading or sim:stage_name(),rows,page,function(p) self:build(p,tab,live) end,back)
    ui:button(748,96,220,54,"Ячейки",back)
    ui:button(989,96,220,54,"Органы",function() self:build(1,"organs",live) end)
    ui:button(1230,96,220,54,"Адаптации",function() self:build(1,"passives",live) end)
    ui:button(1471,96,220,54,"Синергии",function() self:build(1,"synergies",live) end)
    ui:button(1712,96,220,54,"Журнал",function() self:build(1,"journal",live) end)
end

function App:award(id,replace_id,grade)
    local state = self.equipment_state
    if not state then
        state=StageRewards.capture_equipment(self.store.profile,self.sim.build:to_dict())
    end
    if not state then return false end
    local result
    if replace_id and replace_id~="" then
        local draft=Equipment.draft_exchange(state,id,grade)
        if not draft.ok then return false end
        local replacements={}
        for _,organ in ipairs(state.equipped) do
            if organ.kind==replace_id then replacements[1]=organ.id;break end
        end
        if #replacements==0 then return false end
        result=Equipment.move(draft.state,draft.id,"body",replacements)
    else
        result=Equipment.award(state,id,grade)
    end
    if not result.ok then self:notice(result.error);return false end
    self.equipment_state=result.state
    StageRewards.apply_equipment(result.state,self.sim.build)
    self.sim.stock_capacity=result.state.stock_capacity
    if result.location=="reserve" then
        self.sim.pending_inventory[#self.sim.pending_inventory+1]=result.id
    end
    if result.location=="stock" or result.location=="reserve" then
        self:notice(name(id)..(result.location=="stock" and " · в запасе" or " · в архиве"))
    end
    return true
end

function App:accepted(before)
    if not self:save_run() then return self:show_run() end
    local known={}
    for _,id in ipairs(before) do known[id]=true end
    local activated={}
    for _,id in ipairs(self.sim.build:active_synergies()) do
        if not known[id] then activated[#activated+1]=id end
    end
    if #activated==0 then return self:show_run() end
    for _,id in ipairs(activated) do self.sim:_effect(id,self.sim.player,self.sim:body_radius()*1.9,2.1) end
    local ui=self.modal
    self:overlay("synergy")
    local first=Catalog.SYNERGIES[activated[1]]
    local back=function() self:show_run() end
    self.close_current=back
    ui:panel("Синергия пробудилась",first.name,back,1960)
    ui:surface(760,553,760,660,"card")
    local glow=ui:image("cells","surge",760,584,490,490)
    gui.set_color(glow,vmath.vector4(.36,.98,.74,.30))
    local sim=self.sim
    local recipe=sim.player_genome
    local art=BodyArt[recipe.family+1]
    local body=ui:image("cells","body_"..recipe.family,760,584,art[1]*1.38,art[2]*1.38)
    gui.set_color(body,Interface.color(sim:body_color()))
    local anatomy=Anatomy.new(ui.group)
    ui:remember(anatomy.node)
    local preview={player=sim.player,player_genome=recipe,build=sim.build,facing=sim.facing,elapsed=sim.elapsed,
        enemies={},pickups={},remains={},effects={},hp=sim.hp,max_hp=sim.max_hp,
        body_radius=function() return 150 end,body_color=function() return sim:body_color() end,
        spore_charge=sim.spore_charge or 0}
    Anatomy.update(anatomy,preview,ui:layout_x(760),584,150,1,nil,sim.elapsed)
    for _,node in ipairs(anatomy.ribbons) do ui:remember(node) end
    ui:surface(1660,555,930,658,"panel")
    ui:surface(1660,555,918,646,"card")
    ui:box(1660,838,842,5,ui.colors.mint)
    ui:text(1230,785,"СИНЕРГИЯ АКТИВНА",.78,ui.colors.mint)
    ui:fit_text(1230,714,first.name,1.22,ui.colors.pale,760,76)
    local organs={Catalog.item(first.needs[1]).name,Catalog.item(first.needs[2]).name}
    ui:fit_text(1230,624,"Органы · "..table.concat(organs," + "),.86,ui.colors.gold,760,60)
    ui:fit_text(1230,532,first.desc,1.0,ui.colors.pale,760,118)
    if #activated>1 then
        local names={}
        for _,id in ipairs(activated) do names[#names+1]=Catalog.SYNERGIES[id].name end
        ui:fit_text(1230,392,"Пробудились · "..table.concat(names," · "),.76,ui.colors.mint,760,58)
    end
    ui:button(1660,290,740,82,"Продолжить забег",function() self:show_run() end,true,1.02)
end

local draw_offer_preview

function App:replacement(id,grade,apply,back)
    local ui = self.modal
    self:overlay("replace")
    local rows = {}
    local ids=Catalog.ORGANS[id] and Catalog.ORGAN_IDS or Catalog.ADAPTATION_IDS
    for _,old in ipairs(ids) do
        if self.sim.build:rank(old)>0 and old~=id then
            local current=self.sim.build:rank(id)
            local gain=Catalog.ORGANS[id] and Catalog.duplicate_rank_gain(grade or 0) or 1
            local next_rank=current==0 and 1 or math.min(Catalog.max_rank(id),current+gain)
            local replacement_build=setmetatable(Copy(self.sim.build),Build)
            local was_active={}
            for _,synergy_id in ipairs(replacement_build:active_synergies()) do was_active[synergy_id]=true end
            local target=Catalog.ORGANS[id] and replacement_build.organs or replacement_build.adaptations
            local old_target=Catalog.ORGANS[old] and replacement_build.organs or replacement_build.adaptations
            if old_target then old_target[old]=nil end
            if target then target[id]=next_rank end
            replacement_build.qualities[id]=math.max(replacement_build:quality(id),grade or 0)
            replacement_build._synergy_signature=nil
            local synergy_hint
            for _,synergy_id in ipairs(replacement_build:active_synergies()) do
                if not was_active[synergy_id] then
                    synergy_hint="СИНЕРГИЯ ВКЛЮЧИТСЯ · "..Catalog.SYNERGIES[synergy_id].name
                    break
                end
            end
            rows[#rows+1]={id=id,replace_id=old,
                title=name(id),meta="ЗАМЕНА · "..name(old),
                rank=next_rank,grade=grade or 0,
                detail=Catalog.effect_text(id,Catalog.effective_rank(next_rank)),
                extra=synergy_hint or ("Освободит ячейки · "..name(old)),
                extra_color=synergy_hint and ui.colors.mint or ui.colors.dim,action="Заменить"}
        end
    end
    local per_page=3
    local pages=math.max(1,math.ceil(#rows/per_page))
    local function page(p)
        ui:clear()
        ui:panel("Замена органа","Выбери, что освободить · "..name(id),back,2070)
        local shown={}
        for index=(p-1)*per_page+1,math.min(#rows,p*per_page) do shown[#shown+1]=rows[index] end
        Panels.offer_cards(ui,shown,554,function(item)
            local result=apply(item.data.replace_id)
            if result then self:save_run();self:show_run()
            else self:notice("В теле недостаточно свободных ячеек") end
        end,function(item,x,y,radius)
            return draw_offer_preview and draw_offer_preview(ui,self.sim,item,x,y,radius*.30)
        end)
        if pages>1 then
            if p>1 then ui:button(660,182,320,72,"Назад",function() page(p-1) end) end
            ui:text(1230,182,("%d / %d"):format(p,pages),.82,ui.colors.dim,nil,true)
            if p<pages then ui:button(1800,182,320,72,"Далее",function() page(p+1) end) end
        elseif #rows==0 then
            ui:text(1230,554,"Нет подходящего органа для замены",1.0,ui.colors.dim,nil,true)
        end
    end
    page(1)
end

function App:defer_choices()
    self.deferred_choices=true
    self:save_run()
    self:show_run()
end

function App:open_pending()
    self.deferred_choices=false
    local sim=self.sim
    local id=sim.pending_inventory[1]
    if id then
        for _,part in ipairs(Equipment.from_profile(self.store.profile).reserve) do
            if part.id==id then
                self:overlay("inventory_review")
                local close=function() self:defer_choices() end
                self.close_current=close
                local ui=self.modal
                ui:panel("Запас заполнен","Находка сохранена в архиве семейства",close)
                ui:image("icons","icon_"..part.kind,1230,677,218,218)
                ui:text(1230,526,part_caption(part),1.05,ui.colors.mint,nil,true)
                ui:button(946,391,520,88,"Управление",function()
                    self:equipment(part,"reserve",1,true,nil,function() self:open_pending() end)
                end,true)
                ui:button(1514,391,520,88,"Оставить в архиве",function()
                    table.remove(sim.pending_inventory,1)
                    self:save_run()
                    self:open_pending()
                end)
                return
            end
        end
        table.remove(sim.pending_inventory,1)
        return self:open_pending()
    end
    if #sim.reward_queue>0 then self:reward()
    elseif sim.pending_levels>0 then self:level_up()
    else self:show_run() end
end

draw_offer_preview = function(ui,sim,item,x,y,radius)
    if not item.icon then return false end
    local id,grade=item.id or (item.data and item.data.id),item.grade or 0
    local data=item.data or {}
    if not id then return false end
    local build=setmetatable(Copy(sim.build),Build)
    build._synergy_signature=nil
    if data.replace_id then
        local old_target=Catalog.ORGANS[data.replace_id] and build.organs or build.adaptations
        if old_target then old_target[data.replace_id]=nil end
    end
    if data.kind=="evolution" then
        build:evolve(id)
    elseif data.kind=="temporary" then
        build:apply_temporary_mutation(id,grade)
    else
        local target=Catalog.ORGANS[id] and build.organs or build.adaptations
        if target then target[id]=item.rank or data.rank or (target[id] or 0)+1 end
        build.qualities[id]=math.max(build:quality(id),grade)
    end
    build._synergy_signature=nil
    local recipe=sim.player_genome
    local art=BodyArt[recipe.family+1]
    local body=ui:image("cells","body_"..recipe.family,x,y,art[1]*radius/108,art[2]*radius/108)
    gui.set_color(body,Interface.color(Genome.colors(recipe)[1]))
    local anatomy=Anatomy.new(ui.group)
    ui:remember(anatomy.node)
    local preview={player={x=0,y=0},player_genome=recipe,build=build,facing=sim.facing,elapsed=sim.elapsed,
        enemies={},pickups={},remains={},effects={},hp=sim.hp,max_hp=sim.max_hp,
        body_radius=function() return radius end,body_color=function() return sim:body_color() end,
        spore_charge=sim.spore_charge or 0}
    Anatomy.update(anatomy,preview,ui:layout_x(x),y,radius,1,nil,sim.elapsed)
    for _,node in ipairs(anatomy.ribbons) do ui:remember(node) end
    return true
end

function App:level_up()
    local ui,sim=self.modal,self.sim
    self:overlay("level")
    self.deferred_choices=false
    self.close_current=function() self:defer_choices() end
    ui:panel("Мутация · уровень "..sim.level,"Выбери одно улучшение · Биомасса "..sim.build.biomass,self.close_current,2070,"mutation")
    local choices=sim:prepare_offers()
    local shaped={}
    for _,entry in ipairs(choices or {}) do
        local id=type(entry)=="string" and entry or entry.id
        if id then
            local current=sim.build:stored_rank(id)
            local grade=(sim.offer_quality or {})[id] or 0
            local gain=Catalog.ORGANS[id] and Catalog.duplicate_rank_gain(grade) or 1
            local rank=current==0 and 1 or math.min(Catalog.max_rank(id),current+gain)
            local quality=({ "Обычная", "Редкая", "Эпическая", "Легендарная" })[grade+1]
            local baseline=Catalog.effect_text(id,Catalog.effective_rank(rank))
            local rank_text=current==0 and "НОВЫЙ · РАНГ 1" or ("РАНГ %d · СТАНЕТ %d"):format(current,rank)
            local hints,synergy_ready={},false
            for _, synergy_id in ipairs(Catalog.SYNERGY_IDS) do
                local synergy=Catalog.SYNERGIES[synergy_id]
                local first,second=synergy.needs[1],synergy.needs[2]
                if id==first or id==second then
                    local partner=id==first and second or first
                    local ready=sim.build:rank(partner)>0
                    local already_active=sim.build:rank(id)>0 and ready
                    hints[#hints+1]=already_active and ("УЖЕ АКТИВНА · "..synergy.name)
                        or ready and ("ВКЛЮЧИТСЯ · "..synergy.name)
                        or ("НЕ АКТИВНА · нужен "..Catalog.item(partner).name)
                    synergy_ready=synergy_ready or ready
                end
            end
            local hint=#hints>0 and table.concat(hints,"\n") or nil
            local hint_color=synergy_ready and ui.colors.mint or ui.colors.dim
            shaped[#shaped+1]={id=id,rank=rank,grade=grade,meta=rank_text,rarity=quality,detail=baseline,
                extra=hint,extra_color=hint_color,action=current>0 and "Усилить" or "Выбрать"}
        end
    end
    Panels.offer_cards(ui,shaped,505,function(item)
        local before=Copy(sim.build:active_synergies())
        local function apply(old)
            return sim:choose_mutation(item.id,old,function(...) return self:award(...) end)
        end
        if not apply() then self:replacement(item.id,item.grade,apply,function() self:level_up() end)
        else self:accepted(before) end
    end,function(item,x,y,radius) return draw_offer_preview(ui,sim,item,x,y,radius) end)
    if #shaped==0 then
        ui:button(1230,530,650,97,"Получить 15 биомассы",function()
            if sim:take_level_biomass() then self:save_run();self:show_run() end
        end,true)
    end
    local used=sim.rerolls or 0
    if used<3 then
        local price=5+5*used
        local function reroll(focused)
            if sim:reroll_offers(focused) then self:save_run();self:level_up()
            else self:notice("Недостаточно биомассы или новых вариантов") end
        end
        ui:button(966,35,450,54,"Переброс · "..price,function() reroll(false) end,false,.84)
        ui:button(1494,35,450,54,"Ветвь · "..(price+5),function() reroll(true) end,false,.84)
    end
end

function App:colony(index)
    local ui,sim=self.modal,self.sim
    local site=sim.world.colonies[index]
    self:overlay("colony")
    ui:panel("Колония",string.format("Биомасса · %d",sim.build.biomass),function() self:show_run() end,2070)
    local items={}
    for stock_index,entry in ipairs(site.stock or {}) do
        local id,grade=entry.id,entry.quality or 0
        local current=sim.build:rank(id)
        local gain=Catalog.ORGANS[id] and Catalog.duplicate_rank_gain(grade) or 1
        local next_rank=current==0 and 1 or math.min(Catalog.max_rank(id),current+gain)
        local detail=id=="heal" and "Восстанавливает здоровье" or Catalog.effect_text(id,next_rank)
        detail=detail..("\nЦена · %d биомассы"):format(entry.price)
        local synergy_hints,synergy_ready={},false
        local active_synergies={}
        for _,active_id in ipairs(sim.build:active_synergies()) do active_synergies[active_id]=true end
        for _,synergy_id in ipairs(Catalog.SYNERGY_IDS) do
            local synergy=Catalog.SYNERGIES[synergy_id]
            local first,second=synergy.needs[1],synergy.needs[2]
            if id==first or id==second then
                local partner=id==first and second or first
                local ready=sim.build:rank(partner)>0
                synergy_hints[#synergy_hints+1]=active_synergies[synergy_id] and ("УЖЕ АКТИВНА · "..synergy.name)
                    or ready and ("ВКЛЮЧИТСЯ · "..synergy.name)
                    or ("НЕ АКТИВНА · нужен "..Catalog.item(partner).name)
                synergy_ready=synergy_ready or ready
            end
        end
        local synergy_hint=#synergy_hints>0 and table.concat(synergy_hints,"\n") or nil
        local synergy_color=synergy_ready and ui.colors.mint or ui.colors.dim
        items[#items+1]={title=id=="heal" and "Восстановление" or name(id),id=id,
            index=stock_index,grade=grade,action=entry.sold and "Куплено" or (current>0 and "Усилить" or "Встроить"),
            meta=current==0 and "НОВЫЙ ОРГАН · РАНГ 1" or ("РАНГ %d → %d"):format(current,next_rank),
            detail=detail,extra=synergy_hint,extra_color=synergy_color,sold=entry.sold,
            image_atlas=id=="heal" and "collectibles" or nil,image_frame=id=="heal" and "heal" or nil}
    end
    Panels.offer_cards(ui,items,552,function(item)
        if item.sold then return end
        local ok=sim:buy_colony(index,item.data.index,nil,function(...) return self:award(...) end)
        if ok then self:save_run();self:colony(index)
        else self:notice("Покупка недоступна") end
    end,function(item,x,y,radius) return draw_offer_preview(ui,sim,item,x,y,radius*.42) end)
end

function App:reward(skip_animation)
    local ui,sim=self.modal,self.sim
    local reward=sim:prepare_reward()
    if #reward==0 then return self:show_run() end
    local tier=sim.reward_queue[1].tier or 1
    local caption=({"Редкая циста","Эпическая циста","Легендарная циста"})[math.min(3,tier)] or "Циста"
    if not skip_animation and self.last_reveal~=sim.reward_queue[1].token then
        self.last_reveal=sim.reward_queue[1].token
        self:overlay("reveal")
        self.close_current=function() self:defer_choices() end
        ui:panel(caption,"Раскрывается мембрана",self.close_current)
        local palette=({vmath.vector4(.46,.78,1,1),vmath.vector4(.76,.53,.97,1),ui.colors.gold})[math.min(3,tier)]
        local core=ui:image("cells","surge",1230,589,406,406)
        gui.set_color(core,palette)
        local shell_left=ui:image("collectibles","cyst_"..tier.."_left",1150,589,160,320)
        local shell_right=ui:image("collectibles","cyst_"..tier.."_right",1310,589,160,320)
        local inner=ui:image("cells","speck",1230,589,120,120)
        gui.set_color(inner,vmath.vector4(palette.x,palette.y,palette.z,0))
        local icons={}
        for i=1,5 do
            local x=1230+(i-3)*205
            ui:surface(x,337,149,127,"card")
            icons[i]=ui:image("icons","icon_tentacle",x,337,124,124)
            if i~=3 then gui.set_color(icons[i],vmath.vector4(1,1,1,.43)) end
        end
        local text=ui:text(1230,746,caption,.97,palette,nil,true)
        ui:button(1230,208,440,70,"Раскрыть сразу",function() self:reward(true) end,true)
        self.reveal={time=0,core=core,inner=inner,icons=icons,shell_left=shell_left,shell_right=shell_right,
            palette=palette,caption=caption,text=text}
        return
    end
    self.reveal=nil
    self:overlay("reward")
    self.close_current=function() self:defer_choices() end
    ui:panel(caption,"Выбери одну награду",self.close_current,2070)
    Panels.offer_cards(ui,reward or {},550,function(item,index)
        local before=Copy(sim.build:active_synergies())
        local function apply(old)
            return sim:claim_reward(index,old,function(...) return self:award(...) end)
        end
        if not apply() then self:notice("Награда недоступна")
        else self:accepted(before) end
    end,function(item,x,y,radius) return draw_offer_preview(ui,sim,item,x,y,radius*.42) end)
end

function App:stage_transition()
    local ui,sim=self.modal,self.sim
    self:overlay("stage")
    local close_to_pause=function() self:pause() end
    self.close_current=close_to_pause
    local boss = sim.boss_reward or {}
    if boss.organ and not boss.claimed then
        ui:panel("Главная угроза разрушена",boss.name or sim:boss_title(),close_to_pause,1880)
        local parts=sim:boss_reward_materials()
        ui:surface(1230,641,1500,408,"panel")
        ui:surface(1230,641,1484,392,"card")
        local glow=ui:image("cells","surge",770,645,400,400)
        gui.set_color(glow,vmath.vector4(.92,.66,.24,.22))
        local rarity=ui:surface(1230,788,276,48,"button")
        gui.set_color(rarity,Interface.color("584222"))
        ui:text(1230,788,"НАСЛЕДИЕ · ЛЕГЕНДАРНОЕ",.77,ui.colors.gold,nil,true)
        draw_offer_preview(ui,sim,{id=boss.organ,icon=boss.organ,rank=1,grade=3},770,630,122)
        ui:image("icons","icon_"..boss.organ,1140,688,56,56)
        ui:fit_text(1290,713,name(boss.organ),1.20,ui.colors.pale,700,72)
        ui:fit_text(1290,623,Catalog.effect_text(boss.organ,1),.98,ui.colors.gold,700,102)
        ui:fit_text(1290,543,("Расщепление даст · %d органелл · %d мембран · %d плазмы")
            :format(parts.organelle,parts.membrane,parts.plasma),.77,ui.colors.dim,700,54)
        local function claim(take_organ)
            local ok,err=StageRewards.claim_boss_reward(self.store,sim,take_organ)
            if ok then self:stage_transition() else self:notice(err or self.store.last_error) end
        end
        ui:button(850,392,630,82,"Встроить в организм",function() claim(true) end,true,.94)
        ui:button(1610,392,630,82,"Расщепить на материалы",function() claim(false) end,false,.90)
        ui:button(1230,275,1160,68,boss.rerolled and "Переброс использован" or ("Переброс · "..StageRewards.BOSS_REROLL_COST.." органиума"),function()
            local ok,err=StageRewards.reroll_boss_reward(self.store,sim)
            if ok then self:stage_transition() else self:notice(err or self.store.last_error) end
        end,false,.91)
    else
        local seed=math.max(1,sim.pending_stage_seed)
        local stage=sim.stage_index+1
        if self.briefed_seed~=seed then
            self.briefed_seed=seed
            self.screen="briefing_roll"
            ui:panel("Формируется следующая область","Ступень "..stage,function()
                self.briefing=nil
                self:stage_transition()
            end)
            local dial=ui:image("cells","surge",1230,569,335,335)
            local caption=ui:text(826,340,"Сканирование среды",1.13,ui.colors.mint)
            ui:button(1230,214,390,65,"Показать",function() self.briefing=nil;self:stage_transition() end)
            self.briefing={time=0,dial=dial,caption=caption,seed=seed,stage=stage}
            return
        end
        local preview=Simulation.new(seed)
        local next_world=preview.world
        preview.stage_index=stage
        preview:_create_cysts()
        local counts={0,0,0}
        for _,item in ipairs(preview.cysts) do counts[item.tier]=counts[item.tier]+1 end
        local attack=sim:boss_attack(stage,seed)
        ui:panel("Переход на ступень "..stage,sim:stage_name(stage,seed),close_to_pause,2140)
        MapView.grid(ui,next_world,preview,264,305,14,true,false)
        ui:surface(1548,567,820,554,"panel")
        ui:surface(1548,567,808,542,"card")
        ui:box(1548,827,742,4,Interface.color("70ddc1"))
        ui:text(1185,784,"ПРОФИЛЬ СРЕДЫ",.72,ui.colors.mint)
        ui:fit_text(1185,744,"Среда · "..next_world:condition_name(1).." / "..next_world:condition_name(2),.82,ui.colors.dim,720,42)
        ui:fit_text(1185,672,("Цисты · редкие %d · эпические %d · легендарные %d"):format(counts[1],counts[2],counts[3]),.82,ui.colors.gold,720,48)
        ui:fit_text(1185,598,"Главная угроза · "..sim:boss_title(stage,seed),.94,ui.colors.gold,720,52)
        ui:fit_text(1185,522,("%s · %s · %.0f HP"):format(attack.name,attack.hint,1600*(1+.14*(stage-1))),.80,ui.colors.dim,720,64)
        local mini=sim:stage_miniboss_target(stage)
        ui:fit_text(1185,440,("Гнёзда %d · мини-боссы %d · затем босс"):format(math.min(4,mini*2),mini),.80,ui.colors.dim,720,46)
        local combo=sim.build:active_synergies()[1]
        if combo then ui:fit_text(1185,385,"Синергия · "..Catalog.SYNERGIES[combo].name,.82,ui.colors.mint,720,48) end
        ui:button(1548,292,660,82,"Продолжить эволюцию",function()
            local ok,err=StageRewards.enter_next_stage(self.store,sim,next_world)
            if ok then self:show_run() else self:notice(err or self.store.last_error) end
        end,true)
        local cost=StageRewards.stage_reroll_cost(sim.stage_index)
        ui:button(1835,190,650,68,"Переброс · "..cost.." органиума",function()
            local ok,err=StageRewards.reroll_stage_area(self.store,sim)
            if ok then self:stage_transition() else self:notice(err or self.store.last_error) end
        end)
    end
end

function App:finish()
    self.sim:flush_family_materials()
    self:process_events()
    self:save_run()
    self:overlay("finish")
    local ui,sim=self.modal,self.sim
    local function finish_to_menu()
        if self.store:finish_run(sim) then
            self.sim=nil
            self:show_home()
        else self:notice(self.store.last_error) end
    end
    self.close_current=finish_to_menu
    ui:panel("Жизнь завершена · наследие сохранено",
        string.format("%s · уровень %d · ступень %d",sim.outcome=="victory" and "Победа" or "Организм погиб",sim.level,sim.stage_index),
        finish_to_menu,1960)
    ui:surface(1230,570,1710,552,"panel")
    ui:surface(1230,570,1698,540,"card")
    local recipe=sim.player_genome
    local color=sim:body_color()
    local glow=ui:image("cells","surge",692,604,430,430)
    gui.set_color(glow,sim.outcome=="victory" and vmath.vector4(.88,.70,.30,.20) or vmath.vector4(.28,.78,.83,.18))
    local body=portrait(ui,692,594,154,recipe)
    gui.set_color(body,Interface.color(color))
    local anatomy=Anatomy.new(ui.group)
    ui:remember(anatomy.node)
    local preview={player_genome=recipe,build=sim.build,facing=sim.facing,elapsed=sim.elapsed,
        enemies={},pickups={},remains={},effects={},hp=math.max(0,sim.hp),max_hp=sim.max_hp,
        body_radius=function() return 154 end,body_color=function() return color end}
    Anatomy.update(anatomy,preview,ui:layout_x(692),594,154)
    for _,node in ipairs(anatomy.ribbons) do ui:remember(node) end
    local stats=sim.combat_stats or {}
    local kills=0
    for _,count in pairs(stats.kills_by_source or {}) do kills=kills+count end
    ui:text(1090,790,"НАСЛЕДИЕ ЭТОГО ЗАБЕГА",.76,ui.colors.mint)
    ui:fit_text(1090,741,("Время %02d:%02d · уровень %d · ступень %d"):format(
        math.floor(sim.elapsed/60),math.floor(sim.elapsed%60),sim.level,sim.stage_index),.94,ui.colors.pale,1110,54)
    local metrics={
        {""..kills,"ПОВЕРЖЕНО",Interface.color("8ee6c6")},
        {""..(sim.minibosses_defeated or 0),"МИНИ-БОССЫ",Interface.color("d8b8ff")},
        {""..math.floor(stats.blocked or 0),"УРОНА ПОГЛОЩЕНО",Interface.color("93ccff")},
    }
    for i,item in ipairs(metrics) do
        local x=1190+(i-1)*344
        ui:surface(x,630,314,116,"button")
        ui:text(x,650,item[1],1.44,item[3],nil,true)
        ui:text(x,601,item[2],.63,ui.colors.dim,nil,true)
    end
    ui:fit_text(1090,523,("Биомасса %d · лечение %.0f HP · синергии %d"):format(
        math.floor(sim.build.biomass or 0),math.floor(stats.healed or 0),#sim.build:active_synergies()),.82,ui.colors.pale,1110,44)
    local active=sim.build:active_synergies()
    local synergy_names={}
    for _,id in ipairs(active) do synergy_names[#synergy_names+1]=Catalog.SYNERGIES[id].name end
    ui:fit_text(1090,461,#synergy_names>0 and ("Синергии · "..table.concat(synergy_names," · ")) or "Синергии · не собраны",
        .76,active and #active>0 and ui.colors.mint or ui.colors.dim,1110,68)
    ui:button(1230,246,1000,88,"Подготовить следующего потомка",finish_to_menu,true,.96)
end

function App:process_events()
    local sim = self.sim
    if #sim.events==0 then return end
    local profile = self.store.profile
    local next_profile = {}
    for key,value in pairs(profile) do next_profile[key]=value end
    local changed=false
    next_profile.credited={}
    for i,token in ipairs(profile.credited or {}) do next_profile.credited[i]=token end
    local credited={}
    for _,token in ipairs(next_profile.credited) do credited[token]=true end
    local materials={}
    for key,value in pairs(profile.organ_materials or {}) do materials[key]=value end
    next_profile.organ_materials=materials
    for _,event in ipairs(sim.events) do
        if event.type=="message" then self:notice(event.text) end
        if event.token and not credited[event.token] then
            if event.type=="core" then
                next_profile.cores=(next_profile.cores or 0)+event.amount
                self:notice("Ядра наследия +"..event.amount)
            elseif event.type=="organium" then
                next_profile.organium=(next_profile.organium or 0)+event.amount
            elseif event.type=="family_material" then
                for key,value in pairs(event.materials) do materials[key]=(materials[key] or 0)+value end
            elseif event.type=="stage_clear" then
                next_profile.best_stage=math.max(next_profile.best_stage or 0,event.stage)
                sim.best_stage=next_profile.best_stage
                next_profile.organium=(next_profile.organium or 0)+StageRewards.stage_reroll_cost(event.stage)
            elseif event.type=="expansion" then
                local state=Equipment.from_profile(next_profile)
                local key=event.target=="stock" and "stock_capacity" or "body_capacity"
                state[key]=state[key]+(event.amount or 1)
                next_profile.organism=state
                sim.stock_capacity=state.stock_capacity
                sim.build.organ_capacity=state.body_capacity
            end
            next_profile.credited[#next_profile.credited+1]=event.token
            credited[event.token]=true
            changed=true
        end
    end
    if changed then
        local events=sim.events
        sim.events={}
        next_profile.checkpoint=sim:snapshot()
        if not self.store:write_profile(next_profile) then
            sim.events=events
            return self:notice(self.store.last_error)
        end
    else sim.events={} end
end

function App:drive()
    local keys = self.keys
    local dx=(keys.right and 1 or 0)-(keys.left and 1 or 0)
    local dy=(keys.down and 1 or 0)-(keys.up and 1 or 0)
    local stick = self.stick
    if stick then return bounded_direction(stick.x-stick.ox,stick.oy-stick.y,94) end
    return bounded_direction(dx,dy,1)
end

function init(self)
    msg.post(".","acquire_input_focus")
    local app=setmetatable({},App)
    self.app=app
    local smoke=sys.get_config_string("microgen.smoke_run","0")=="1"
    if smoke then assert(ScreenLayout.test()) end
    app.store=Save.new(smoke and "native_smoke" or nil)
    app.store:load_profile()
    app.audio=Audio.new()
    app.audio_enabled=app.store.profile.audio_enabled~=false
    app.show_metrics=app.store.profile.show_metrics~=false
    app.diag=Diagnostics.new()
    app.driver=graphics.get_adapter_info().family or "GPU"
    app.scene=Scene.new(Tissue.load_atlas())
    app.hud=Interface.new()
    app.hud.group="hud"
    app.modal=Interface.new()
    app.fixed=Interface.new()
    app.fixed.group="feedback"
    app.toast=app.fixed:text(82,145,"",.81,app.fixed.colors.pale,1510)
    app.toast_time=0
    app.stick_base=app.fixed:box(0,0,172,172,vmath.vector4(.16,.56,.58,.35))
    app.stick_tip=app.fixed:box(0,0,64,64,vmath.vector4(.55,1,.87,.68))
    for _,node in ipairs({app.stick_base,app.stick_tip}) do
        gui.set_texture(node,"cells")
        gui.play_flipbook(node,"shield")
    end
    app.cover=gui.new_box_node(vmath.vector3(1230,540,0),vmath.vector3(WIDTH,HEIGHT,0))
    gui.set_layer(app.cover,"water")
    gui.set_texture(app.cover,"world")
    gui.play_flipbook(app.cover,"terrain")
    app.focused=true
    app.updater=Updater.new(sys.get_config_string("project.version","0.4.0"), microgen_updater,
        not smoke and microgen_updater~=nil, function()
            if app.screen=="updates" then app:updates()
            elseif app.screen=="home" and app.updater.state=="ready" then app:show_home() end
        end)
    app:show_home()
    print("MICROGEN PREVIEW READY "..app.driver)
    window.set_listener(function(_,event)
        if event==window.WINDOW_EVENT_FOCUS_GAINED then app.focused=true end
        if event==window.WINDOW_EVENT_FOCUS_LOST then
            app.focused=false
            app:clear_pointer()
            if app.sim and app.screen=="run" then app:pause() end
        end
    end)
    if smoke then
        local window_width,window_height=window.get_size()
        local scene_width,scene_height=gui.get_width(),gui.get_height()
        local left,right,top,bottom=ScreenLayout.safe_bounds(
            window_width,window_height,scene_width,scene_height,window.get_safe_area(),42,33)
        local lx,ly=stick_visual_origin(-100,-100)
        local rx,ry=stick_visual_origin(scene_width+100,scene_height+100)
        if right-left>=180 then
            assert(lx>=left+89 and rx<=right-89,"Joystick artwork must remain horizontally inside safe area")
        end
        if top-bottom>=180 then
            assert(ly>=bottom+89 and ry<=top-89,"Joystick artwork must remain vertically inside safe area")
        end
        assert(can_start_movement("run",nil,left,left,right),
            "Safe-area left edge must start one-finger movement")
        assert(can_start_movement("run",nil,left+(right-left)*.25,left,right),
            "Left quarter must start one-finger movement")
        assert(can_start_movement("run",nil,left+(right-left)*.80,left,right),
            "Right-side empty space must also start one-finger movement")
        assert(not can_start_movement("run",function() end,left+(right-left)*.80,left,right),
            "A right-side interface button must keep priority over movement")
        assert(not can_start_movement("map",nil,left+(right-left)*.80,left,right),
            "Touches on non-gameplay screens must not start movement")
        print("MICROGEN TOUCH ZONES READY")
        if #app.store:family_summaries()==0 then
            app.home_slot=3
            app:show_home()
            assert(app.home_slot==3 and app.screen=="home")
            assert(app.store:create_family("Первый забег","predator"))
            assert(app.store:create_family("Второй забег","predator",3))
            app.home_slot=nil
            app:show_home()
            assert(app.home_slot==3 and app.screen=="home")
        end
        app:start(47)
    end
    if smoke and sys.get_config_string("microgen.smoke_balance","0")=="1" then
        require("main.run.balance_smoke").run()
    end
    if smoke and sys.get_config_string("microgen.smoke_cards","0")=="1" then
        local sim=app.sim
        local breath_peak=Scene.breathing_scale(math.pi/(2*2.1),1,.014)
        local breath_trough=Scene.breathing_scale(3*math.pi/(2*2.1),1,.014)
        local npc_breath=Scene.breathing_scale(math.pi/(2*2.1),1,.009)
        assert(breath_peak>1 and breath_peak<=1.014001
            and breath_trough<1 and breath_trough>=.985999
            and npc_breath>1 and npc_breath<breath_peak,
            "Organism breathing must stay subtle and bounded")
        local shape_x,shape_y=Scene.breathing_shape(0,1,.014)
        assert(shape_x>=.986 and shape_x<=1.014 and shape_y>=.9908
            and shape_y<=1.0092 and math.abs(shape_x-shape_y)>.001,
            "Membrane breathing must remain subtle and slightly asymmetric")
        local calm_x,calm_y=Scene.damage_shape(0)
        local hit_x,hit_y=Scene.damage_shape(1)
        local over_x,over_y=Scene.damage_shape(5)
        assert(calm_x==1 and calm_y==1 and hit_x>=.964 and hit_x<1
            and hit_y>1 and hit_y<=1.022 and over_x==hit_x and over_y==hit_y,
            "Damage deformation must be bounded and recover to the resting shape")
        local calm_flow_x,calm_flow_y=Tissue.damage_flow(0,1,0)
        local hit_flow_x,hit_flow_y=Tissue.damage_flow(1,1,0)
        local diagonal_flow_x,diagonal_flow_y=Tissue.damage_flow(1,1,1)
        assert(calm_flow_x==0 and calm_flow_y==0 and hit_flow_x<-.099 and hit_flow_x>-.101
            and math.abs(hit_flow_y)<.001
            and math.abs(math.sqrt(diagonal_flow_x^2+diagonal_flow_y^2)-.10)<.001,
            "Directional membrane recoil must be smooth, normalized, and bounded")
        local player_point=vmath.vector3(0,0,0)
        local recoil_right_x,recoil_right_y=Scene.damage_direction(player_point,0,{pos={100,0}})
        local recoil_north_x,recoil_north_y=Scene.damage_direction(player_point,0,{pos={0,100}})
        local recoil_rotated_x,recoil_rotated_y=Scene.damage_direction(player_point,math.pi*.5,{pos={100,0}})
        assert(recoil_right_x>.999 and math.abs(recoil_right_y)<.001
            and math.abs(recoil_north_x)<.001 and recoil_north_y>.999
            and math.abs(recoil_rotated_x)<.001 and recoil_rotated_y<-.999
            and Scene.damage_direction(player_point,0,{})==0,
            "Damage recoil direction must follow the incoming source in local body coordinates")
        local east=Scene.damage_impact(player_point,50,{pos=vmath.vector3(100,0,0),time=4},4)
        local north,north_angle,strength=Scene.damage_impact(
            player_point,50,{pos=vmath.vector3(0,100,0),time=4},4)
        assert(east and east.x>player_point.x and math.abs(east.y-player_point.y)<.001
            and north and north.y>player_point.y and math.abs(north.x-player_point.x)<.001
            and north_angle>1.5 and north_angle<1.6 and strength==1,
            "Membrane impact pulse must follow the incoming damage direction")
        assert(Scene.damage_impact(player_point,50,{pos=vmath.vector3(100,0,0),time=4},4.5)==nil
            and Scene.damage_impact(player_point,50,{time=4},4)==nil,
            "Membrane impact pulse must expire and ignore damage without a source position")
        local reaction_sim=Simulation.new(49)
        local reaction_facing=reaction_sim.facing
        local hit_pos={x=reaction_sim.player.x+math.cos(reaction_facing)*100,
            y=reaction_sim.player.y+math.sin(reaction_facing)*100}
        -- Establish the renderer's pre-hit health baseline before applying damage.
        app.scene:render(reaction_sim)
        reaction_sim:hurt_player(12,{kind="collision",name="Тестовый удар по мембране",pos=hit_pos,id=-909})
        app.scene:render(reaction_sim)
        assert(app.scene.reaction>0 and app.scene.impact_strength>.99
            and app.scene.impact_x>.99 and math.abs(app.scene.impact_y)<.01,
            "A live collision must deform the rendered membrane toward the impact")
        print("MICROGEN MEMBRANE HIT RESPONSE READY")
        app.scene.reaction,app.scene.impact_x,app.scene.impact_y,app.scene.impact_strength=0,0,0,0
        app.scene.last_hp=sim.hp
        app.scene:render(sim)
        print("MICROGEN ORGANISM BREATHING READY")
        local feed_item={entry_angle=0,entry_distance=100,r=100}
        local feed_start,scale_start,alpha_start=Scene.feeding_pose(sim,feed_item,0)
        local feed_mid,scale_mid,alpha_mid=Scene.feeding_pose(sim,feed_item,.5)
        local feed_fade,scale_fade,alpha_fade=Scene.feeding_pose(sim,feed_item,.8)
        local turn_start,turn_mid,turn_end=Scene.feeding_turn(0),Scene.feeding_turn(.5),Scene.feeding_turn(1)
        assert(math.abs(turn_start)<.001 and turn_mid>.05 and turn_mid<.141
            and math.abs(turn_end)<.001,
            "Absorbed fragments must rotate gently and settle on entry")
        local feed_end,scale_end,alpha_end=Scene.feeding_pose(sim,feed_item,1)
        local function radial_distance(point)
            return math.sqrt((point.x-sim.player.x)^2+(point.y-sim.player.y)^2)
        end
        assert(math.abs(feed_start.y-sim.player.y)<.001
            and math.abs(feed_end.y-sim.player.y)<.001,
            "Absorption trajectory must begin and end on the entry axis")
        assert(math.abs(feed_mid.y-sim.player.y)>.1,
            "Absorption trajectory must include a visible inward curl")
        assert(radial_distance(feed_mid)<radial_distance(feed_start)
            and radial_distance(feed_end)<radial_distance(feed_mid),
            "Absorption must move monotonically toward the organism")
        assert(scale_start>=scale_mid and scale_mid>scale_fade
            and scale_fade>scale_end and alpha_start>=alpha_mid
            and alpha_mid>alpha_fade and alpha_fade>alpha_end,
            "Absorbed tissue must shrink and fade monotonically")
        print("MICROGEN ABSORPTION ANIMATION READY")
        local function check_window()
            local ui=app.modal
            if ui.panel_width then
                assert(gui.get_size(ui.nodes[2]).x>=2139,"Narrow panel: "..app.screen)
            end
            for _,button in ipairs(ui.buttons) do
                local pos,size=gui.get_position(button.node),gui.get_size(button.node)
                assert(pos.x-size.x/2>=0 and pos.x+size.x/2<=WIDTH
                    and pos.y-size.y/2>=0 and pos.y+size.y/2<=HEIGHT,
                    "Button outside window: "..app.screen.." / "..gui.get_text(button.text))
            end
        end
        app:show_families();check_window()
        app:show_home();check_window()
        app.sim=sim
        app:help();check_window()
        app:updates();check_window()
        app:new_family(2);check_window()
        app:delete_family(app.store:family_summaries()[1]);check_window()
        Panels.catalog(app);check_window()
        for _,section in ipairs({"organs","adaptations","temporary","synergies","specializations","evolutions"}) do
            Panels.catalog(app,section,1);check_window()
            app.modal.buttons[2].callback();check_window()
            assert(app.screen=="codex_entry")
        end
        Panels.legacy(app);check_window()
        for _,section in ipairs({"form","trait","imprint","presets","research","upgrades"}) do
            Panels.legacy(app,section,1);check_window()
        end
        app:inventory(1,true);check_window()
        app:stock_sources(true);check_window()
        app:pause();check_window()
        app:colony(1);check_window()
        app:show_run()
        sim.level,sim.pending_levels=10,1
        sim.build.biomass=108
        sim.current_offers={"enzymes","barrier","armor"}
        sim.offer_quality={enzymes=2}
        app:body(true)
        assert(app.screen=="build")
        app:body(false)
        assert(app.screen=="preparation")
        app:show_run()
        print("MICROGEN ORGANISM PANEL READY")
        local prior_barrier,prior_cooldown=sim.build.organs.barrier,sim.cooldowns.barrier
        sim.build.organs.barrier=1
        sim.cooldowns.barrier=0
        app:draw_hud()
        assert(app.hud_has_barrier and gui.get_text(app.shield_metric):find("Щит готов",1,true))
        local vitals_position,vitals_size=gui.get_position(app.vitals),gui.get_size(app.vitals)
        assert(math.abs(vitals_position.x-vitals_size.x/2)<0.01,
            "Gameplay vitals panel must touch the left scene edge")
        sim.cooldowns.barrier=4
        app:draw_hud()
        assert(gui.get_size(app.shield).x==360 and gui.get_text(app.shield_metric):find("4.0",1,true))
        sim.build.organs.barrier=nil
        app:draw_hud()
        assert(not app.hud_has_barrier and gui.get_size(app.vitals).y==340)
        sim.build.organs.barrier,sim.cooldowns.barrier=prior_barrier,prior_cooldown
        app:draw_hud()
        app.scene:render(sim)
        app:map()
        assert(app.screen=="map")
        app:show_run()
        local labels=app.scene.labels
        local tint=vmath.vector4(1,.5,.5,1)
        app.scene:draw_number(sim.player,"6",tint,1)
        app.scene:draw_number(sim.player,"Враждебная амёба · споры",tint,1)
        assert(labels.count==2 and labels.slots[1].enabled and labels.slots[2].enabled)
        app:notice("Враждебная амёба · споры")
        app:level_up()
        assert(labels.layer=="world_labels" and labels.count==0
            and not labels.slots[1].enabled and not labels.slots[2].enabled
            and gui.get_text(app.toast)=="")
        app.scene:draw_number(sim.player,"+0.2",tint,1)
        assert(labels.count==0)
        app:show_run()
        app.scene:draw_number(sim.player,"6",tint,1)
        assert(labels.count==1 and labels.slots[1].enabled)
        app:overlay("smoke_list")
        local sample_rows={
            {title="Орган",icon="tentacle",meta="РАНГ 2 · 3 ЯЧ.",detail="Увеличивает захват",label="Открыть",action=function() end},
            {title="Исследование",meta="Ранг 1 / 5",detail="Усиливает организм",label="Улучшить",action=function() end},
            {title="Синергия",meta="СИНЕРГИЯ АКТИВНА",detail="Щупальца + кислота",extra="Эффект действует",label="Подробнее",action=function() end},
            {title="Потомок",meta="Поколение 2",detail="Наследие сохранено",label="Выбрать",action=function() end},
        }
        Panels.list(app.modal,"Проверка карточек","Карточки меню и кодекса",sample_rows,1,function() end,function() end)
        check_window()
        assert(#app.modal.buttons>=5)
        local card_button=app.modal.buttons[3]
        local position,size=gui.get_position(card_button.node),gui.get_size(card_button.node)
        assert(position.x>1800 and app.modal:hit(position.x+size.x*.4,position.y)==card_button.callback)
        print("MICROGEN MENU CARDS READY")
        local prior_barrier_rank=sim.build.organs.barrier
        sim.build.organs.barrier=1
        app:replacement("enzymes",2,function() return false end,function() end)
        assert(app.screen=="replace" and #app.modal.buttons>=2)
        print("MICROGEN REPLACEMENT CARDS READY")
        sim.build.organs.barrier=prior_barrier_rank
        local prior_boss_reward=sim.boss_reward
        sim.boss_reward={organ="enzymes",name="Тестовый архит",claimed=false}
        app:stage_transition()
        assert(app.screen=="stage" and #app.modal.buttons>=3)
        check_window()
        sim.boss_reward={claimed=true}
        app:stage_transition();check_window()
        assert(app.screen=="briefing_roll")
        app:stage_transition();check_window()
        assert(app.screen=="stage")
        print("MICROGEN BOSS REWARD READY")
        sim.boss_reward=prior_boss_reward
        local prior_outcome=sim.outcome
        sim.outcome="death"
        app:finish()
        assert(app.screen=="finish" and #app.modal.buttons>=1)
        print("MICROGEN LEGACY SCREEN READY")
        sim.outcome=prior_outcome
        app:level_up()

        local fracture_sim=Simulation.new(47)
        fracture_sim.enemies={}
        fracture_sim.residents={}
        local center={x=fracture_sim.player.x+220,y=fracture_sim.player.y}
        local enemy=fracture_sim:spawn_enemy(center,"hunter")
        enemy.r=75
        app.scene:render(fracture_sim)
        local target=app.scene.organisms.slots[1]
        local original_texture,original_frame=target.texture,target.frame
        local original_position=gui.get_position(target.node)
        local original_size=gui.get_size(target.node)
        fracture_sim:_die(1,false)
        app.scene:render(fracture_sim)
        local previous=0
        for index,part in ipairs(fracture_sim.remains) do
            local slot=app.scene.fragments.slots[index]
            assert(slot.enabled and slot.texture==original_texture and slot.frame==original_frame and slot.pose)
            local fragment_position=gui.get_position(slot.node)
            local fragment_size=gui.get_size(slot.node)
            assert(vmath.length(fragment_position-original_position)<.01
                and vmath.length(fragment_size-original_size)<vmath.length(original_size)*.02,
                "Fracture pieces must preserve the parent silhouette within breathing amplitude")
            assert(part.cut_start==previous and part.cut_end>previous)
            previous=part.cut_end
        end
        assert(#fracture_sim.remains==5 and previous==2*math.pi)
        local first=fracture_sim.remains[1]
        first.pos={x=first.pos.x+125,y=first.pos.y}
        app.scene:render(fracture_sim)
        assert(gui.get_position(app.scene.fragments.slots[1].node).x>original_position.x)

        -- Проверяем полный цикл останков: задержка высвобождения, захват,
        -- переваривание и освобождение слота визуального пула.
        local collected=fracture_sim.remains[1]
        assert(collected and collected.release_delay>0)
        fracture_sim:_update_remains(collected.release_delay+0.01)
        assert(collected.release_delay==0)
        collected.pos={x=fracture_sim.player.x,y=fracture_sim.player.y}
        fracture_sim:_update_remains(0.01)
        assert(collected.captured)
        local remains_before=#fracture_sim.remains
        fracture_sim:_update_remains((collected.duration or 1)+0.1)
        assert(#fracture_sim.remains==remains_before-1)
        app.scene:render(fracture_sim)
        assert(app.scene.fragments.slots[5].enabled==false)

        local absorbed_sim=Simulation.new(48)
        absorbed_sim.enemies={}
        absorbed_sim.residents={}
        local absorbed_enemy=absorbed_sim:spawn_enemy(center,"hunter")
        absorbed_enemy.r=75
        local biomass_before=absorbed_sim.build.biomass
        absorbed_sim:_die(1,true)
        assert(#absorbed_sim.remains==0 and absorbed_sim.build.biomass>biomass_before)

        local boss=fracture_sim:spawn_enemy(center,"boss")
        app.scene:render(fracture_sim)
        local boss_frame=app.scene.body_looks[boss.id].frame
        fracture_sim:_die(1,false)
        app.scene:render(fracture_sim,0)
        assert(#fracture_sim.boss_breakup.pieces==7 and #fracture_sim.remains==4)
        for index=5,11 do
            local slot=app.scene.fragments.slots[index]
            assert(slot.enabled and slot.texture=="cells" and slot.frame==boss_frame and slot.pose)
        end
        print("MICROGEN TISSUE FRACTURE READY")
        print("MICROGEN TISSUE LIFECYCLE READY")
        print("MICROGEN MUTATION CARDS READY")
        app:map()
        check_window()
        local map_controls={}
        for _,button in ipairs(app.modal.buttons) do
            local label=gui.get_text(button.text)
            if label=="+" or label=="−" or label=="Общий вид" or label=="×" then
                local position=gui.get_position(button.node)
                assert(app.modal:hit(position.x,position.y)==button.callback,
                    "Map control hit area mismatch: "..label)
                map_controls[label]=true
            end
        end
        assert(map_controls["+"] and map_controls["−"] and map_controls["Общий вид"] and map_controls["×"],
            "Map controls missing from smoke scenario")
        local function map_callback(label)
            for _,button in ipairs(app.modal.buttons) do
                if gui.get_text(button.text)==label then return button.callback end
            end
        end
        -- Exercise the real App:map zoom closure without rebuilding several
        -- complete GUI trees in one init frame (Defold releases deleted nodes
        -- after the frame is flushed).
        local original_map,original_show_run=app.map,app.show_run
        local map_redraws=0
        app.map=function(self) map_redraws=map_redraws+1;self.screen="map" end
        map_callback("+")()
        assert(app.screen=="map" and map_redraws==1 and math.abs(app.map_zoom-1.12)<0.001,
            "Map zoom-in control must increase zoom and request a map redraw")
        app.modal:clear()
        app.modal:fit_safe_area()
        MapView.screen(app.modal,sim,function() app.screen="run" end,1.12,
            function(value) app.map_zoom=value end,function() app.map_zoom=1 end)
        check_window()
        map_callback("−")()
        assert(app.screen=="map" and math.abs(app.map_zoom-1.0)<0.001,
            "Map zoom-out control must restore the default zoom")
        app.map_zoom=1.12
        map_callback("Общий вид")()
        assert(math.abs(app.map_zoom-1.0)<0.001,
            "Map overview control must restore the default zoom")
        map_callback("×")()
        assert(app.screen=="run","Map close control must return to the active run")
        app.map,app.show_run=original_map,original_show_run
        print("MICROGEN MAP CONTROLS READY")
    end
end

function update(self,dt)
    local app=self.app
    app.updater:step(dt, app.focused and (app.screen=="home" or app.screen=="updates"))
    local fps,p95=app.diag:step()
    if fps then
        if not app.sampled then print("MICROGEN PREVIEW SAMPLE "..app.driver);app.sampled=true end
        if app.metrics and app.sim and app.show_metrics then
            gui.set_text(app.metrics,string.format("%.0f FPS · P95 ≤ %.1f мс",fps,p95))
        end
    end
    if app.screen=="briefing_roll" then
        local state=app.briefing
        state.time=state.time+dt
        local fraction=math.min(1,state.time/1.42)
        local step=math.floor(16*(1-(1-fraction)^2))
        if step~=state.step then
            state.step=step
            gui.set_text(state.caption,app.sim:stage_name(state.stage,state.seed+step))
        end
        local zoom=.75+.24*fraction+.05*math.sin(state.time*18)
        gui.set_scale(state.dial,vmath.vector3(zoom,zoom,1))
        gui.set_rotation(state.dial,vmath.vector3(0,0,fraction*245))
        if fraction>=1 then app.briefing=nil;app:stage_transition() end
    end
    if app.screen=="reveal" then
        local state=app.reveal
        state.time=state.time+dt
        local fraction=math.min(1,state.time/2.6)
        local step=math.floor(24*(1-(1-fraction)^2.4))
        if step~=state.step then
            state.step=step
            for i,icon in ipairs(state.icons) do
                local ids=Catalog.ORGAN_IDS
                gui.play_flipbook(icon,"icon_"..ids[(step*7+i*3)%#ids+1])
            end
        end
        local scale=.72+fraction*.52+.04*math.sin(state.time*18)
        gui.set_scale(state.core,vmath.vector3(scale,scale,1))
        gui.set_rotation(state.core,vmath.vector3(0,0,fraction*145))
        local open=math.min(1,math.max(0,(state.time-.9)))
        open=open*open*(3-2*open)
        local sway=5*math.sin(state.time*19)*(1-open)
        gui.set_position(state.shell_left,vmath.vector3(app.modal:layout_x(1150-open*100+sway),589+open*19,0))
        gui.set_position(state.shell_right,vmath.vector3(app.modal:layout_x(1310+open*100+sway),589-open*11,0))
        gui.set_rotation(state.shell_left,vmath.vector3(0,0,open*20))
        gui.set_rotation(state.shell_right,vmath.vector3(0,0,-open*20))
        gui.set_color(state.inner,vmath.vector4(state.palette.x,state.palette.y,state.palette.z,open))
        gui.set_scale(state.inner,vmath.vector3(scale,scale,1))
        if state.time>=1.7 and not state.opened then
            state.opened=true
            gui.set_text(state.text,state.caption.." · мутации сформированы")
        end
        if fraction>=1 then app:reward(true) end
    end
    if app.toast_time>0 then
        app.toast_time=app.toast_time-dt
        if app.toast_time<=0 then gui.set_text(app.toast,"") end
    end
    local sim=app.sim
    if not sim then
        if app.home_world and app.screen=="home" and app.focused then
            app.home_delta=(app.home_delta or 0)+dt
            if app.home_delta>=1/30 then
                app.home_world.elapsed=app.home_world.elapsed+math.min(.1,app.home_delta)
                app.home_delta=0
                app.scene:render(app.home_world)
            end
        end
        return
    end
    if app.screen=="run" then
        local dx,dy=app:drive()
        local rewards_before=#sim.reward_queue
        sim:step(math.min(.1,dt),dx,dy)
        if #sim.reward_queue>rewards_before then app.deferred_choices=false end
        app:process_events()
        if sim.stage_transition then app.breakup_time=(app.breakup_time or 0)+dt end
        app.scene:render(sim,app.breakup_time)
        app.hud_timer=(app.hud_timer or 0)+dt
        if app.hud_timer>.10 then app.hud_timer=0;app:draw_hud() end
        app.save_time=app.save_time+dt
        if app.save_time>=12 then app.save_time=0;app:save_run() end
        if sim.outcome and sim.outcome~="" then app:finish()
        elseif sim.stage_transition then
            if app.breakup_time>=1.35 then app.breakup_time=nil;app:stage_transition() end
        elseif not app.deferred_choices and (#sim.reward_queue>0 or #sim.pending_inventory>0 or sim.pending_levels>0) then
            app:open_pending()
        end
        local pending=#sim.reward_queue+#sim.pending_inventory+sim.pending_levels
        if pending>0 and app.screen=="run" then
            if not app.reward_button then
                app.reward_button=app.hud:button(app.reward_x,app.reward_y,288,81,"",function() app:open_pending() end,true)
            end
            gui.set_text(app.reward_button.text,string.format("Награда · %d",pending))
            Interface.button_enabled(app.reward_button,true)
        elseif app.screen=="run" and app.reward_button then Interface.button_enabled(app.reward_button,false) end
    end
    app.audio:consume(sim,app.audio_enabled,app.screen~="run")
    sim.feedback={}
end

local function pointer(app,id,x,y,pressed,released)
    if pressed and app.touch_id==nil then
        local press_action=app.modal:hit(x,y) or (app.screen=="run" and app.hud:hit(x,y))
        local left,right=touch_zones()
        local starts_movement=can_start_movement(app.screen,press_action,x,left,right)
        -- UI actions win; any other touch within the safe playfield controls movement.
        if press_action or starts_movement then
            app.touch_id=id
            app.press_action=press_action
            if starts_movement then
                local visual_x,visual_y=stick_visual_origin(x,y)
                app.stick={ox=x,oy=y,x=x,y=y,visual_x=visual_x,visual_y=visual_y}
            end
        end
    end
    if app.touch_id~=id then return end
    if released then
        local chosen=app.press_action
        local over=app.modal:hit(x,y) or (app.screen=="run" and app.hud:hit(x,y))
        app:clear_pointer()
        if chosen and over==chosen then chosen() end
    elseif app.stick then
        local stick=app.stick
        stick.x,stick.y=x,y
        local dx,dy=bounded_direction(x-stick.ox,y-stick.oy,94)
        gui.set_position(app.stick_base,vmath.vector3(stick.visual_x,stick.visual_y,0))
        gui.set_position(app.stick_tip,vmath.vector3(stick.visual_x+dx*57,stick.visual_y+dy*57,0))
        gui.set_enabled(app.stick_base,true)
        gui.set_enabled(app.stick_tip,true)
    end
end

function on_input(self,id,action)
    local app=self.app
    if action.pressed and app.screen=="run" then
        if id==hash("map") then app:map();return true end
        if id==hash("build") then app.development_origin=nil;app:body(true);return true end
        if id==hash("colony") then
            local index=app.sim:nearby_colony()
            if index>0 then app:colony(index) end
            return true
        end
    end
    local direction=DIRECTIONS[id]
    if direction then
        if action.pressed then app.keys[direction]=true end
        if action.released then app.keys[direction]=nil end
        return true
    end
    if id==hash("back") and action.pressed then
        if app.screen=="run" then app:pause()
        elseif app.screen=="pause" then app:show_run()
        elseif app.close_current then app.close_current()
        elseif app.sim and (app.screen=="build" or app.screen=="map" or app.screen=="colony") then app:show_run()
        elseif not app.sim then app:show_home() end
        return true
    end
    if id==hash("touch") and action.touch then
        for _,point in ipairs(action.touch) do
            pointer(app,point.id,point.x,point.y,point.pressed,point.released)
        end
        return true
    end
    if id==hash("pointer") then
        pointer(app,"mouse",action.x,action.y,action.pressed,action.released)
        return true
    end
end

function final(self)
    local app=self.app
    if app and app.sim and app.screen~="home" then app:save_run() end
    if app then app.audio:stop() end
end
