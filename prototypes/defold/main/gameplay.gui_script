local Anatomy = require "main.anatomy"
local Build = require "main.run.build_model"
local Updater = require "main.run.updater"
local Audio = require "main.run.audio"
local BodyArt = require "main.body_art"
local Genome = require "main.run.genome"
local Heredity = require "main.run.heredity"
local Inspector = require "main.run.build_inspector"
local CombatStats = require "main.run.combat_stats"
local Catalog = require "main.run.catalog"
local Diagnostics = require "main.run.diagnostics"
local Equipment = require "main.run.organism_equipment"
local Slots = require "main.run.organism_slots"
local Interface = require "main.run.interface"
local Legacy = require "main.run.genome_legacy"
local Minimap = require "main.run.minimap"
local StageRewards = require "main.run.stage_rewards"
local Copy = require("main.run.meta_util").copy
local Panels = require "main.run.panels"
local Save = require "main.run.save_store"
local Scene = require "main.run.scene"
local Simulation = require "main.run.simulation"
local Tissue = require "main.tissue_motion"

local WIDTH, HEIGHT = Interface.width, Interface.height
local App = {}
App.__index = App
local DIRECTIONS = {[hash("up")]="up",[hash("down")]="down",[hash("left")]="left",[hash("right")]="right"}

local function bounded_direction(dx,dy,r)
    local length = math.sqrt(dx*dx+dy*dy)
    if length<=.0001 then return 0,0 end
    local strength = math.min(1,length/r)
    return dx*strength/length,dy*strength/length
end

local function has_checkpoint(profile)
    return type(profile.checkpoint)=="table" and next(profile.checkpoint)~=nil
end

local function name(id)
    local entry = Catalog.item(id)
    return entry and entry.name or tostring(id)
end

function App:notice(message)
    if type(message)=="string" and #message>0 then
        gui.set_text(self.toast,message)
        self.toast_time=4.2
    end
end

function App:clear_pointer()
    self.touch_id,self.stick,self.press_action = nil,nil,nil
    self.keys={}
    gui.set_enabled(self.stick_base,false)
    gui.set_enabled(self.stick_tip,false)
end

function App:overlay(kind)
    self:clear_pointer()
    self.modal:clear()
    self.scene:set_labels_visible(kind == "run")
    if kind ~= "run" then
        self.hud:visible(false)
        self.toast_time=0
        gui.set_text(self.toast,"")
    end
    self.screen=kind
    self.close_current=nil
end

local function family_profile(store,id)
    if id==store:family_id() then return store.profile end
    for _,family in ipairs(store.profile.families.items) do
        if family.id==id then return family.state end
    end
end

local function family_recipe(profile,form)
    local checkpoint=profile and profile.checkpoint or {}
    if Genome.validate(checkpoint.player_genome) then return checkpoint.player_genome end
    if profile then return Heredity.recipe(Legacy.loadout(profile)) end
    local recipe=Genome.create(14481,0,"player",0)
    recipe.family=({predator=1,toxic=0,colony=4})[form] or 1
    if form=="toxic" then recipe.tissue=2 end
    return recipe
end

local function portrait(ui,x,y,radius,recipe)
    local art=BodyArt[recipe.family+1]
    local body=ui:image("cells","body_"..recipe.family,x,y,art[1]*radius/108,art[2]*radius/108)
    gui.set_color(body,Interface.color(Genome.colors(recipe)[1]))
    return body
end

local HOME_SLOTS = 3

function App:show_home()
    self:overlay("home")
    self.audio:stop()
    self.sim=nil
    self.hud:clear()
    self.metrics=nil
    if not self.home_world then self.home_world=Simulation.new(14481) end
    self.scene:render(self.home_world)
    gui.set_enabled(self.cover,false)
    local ui=self.modal
    ui:box(1230,540,2460,1080,vmath.vector4(.015,.035,.05,.55))
    local families=self.store:family_summaries()
    local total=math.max(HOME_SLOTS,#families)
    local page=self.home_slot
    if not page then
        for i,family in ipairs(families) do
            if family.id==self.store:family_id() then page=i;break end
        end
    end
    page=math.min(total,page or 1)
    self.home_slot=page
    local family=families[page]
    ui:text(1230,977,"МИКРОГЕН",1.92,ui.colors.pale,nil,true)
    ui:surface(1230,590,1770,596,"panel")
    ui:button(216,590,132,230,"‹",page>1 and function()
        self.home_slot=page-1
        self:show_home()
    end or nil,false,1.6)
    ui:button(2244,590,132,230,"›",page<total and function()
        self.home_slot=page+1
        self:show_home()
    end or nil,false,1.6)
    ui:text(1230,242,("%d / %d"):format(page,total),1,ui.colors.dim,nil,true)

    local function new()
        if #families<HOME_SLOTS then self:new_family() else self:show_families() end
    end
    if family then
        local profile=family_profile(self.store,family.id)
        local form=Legacy.FORMS[profile.legacy.selected_form] or Legacy.FORMS[family.form]
        portrait(ui,735,590,172,family_recipe(profile,family.form))
        ui:fit_text(1110,795,form.name.." амёба",1.50,ui.colors.pale,870,75)
        ui:fit_text(1110,700,form.desc,1,ui.colors.pale,850,75)
        local stage=profile.checkpoint.stage_index or 1
        ui:text(1110,620,("%s · Поколение %d · Ступень %d"):format(family.name,family.generation,stage),.91,ui.colors.dim,850)
        ui:button(1550,508,880,106,family.alive and "Продолжить" or "Подготовить",function()
            if not self.store:select_family(family.id) then return self:notice(self.store.last_error) end
            self.equipment_state=nil
            self.body_page,self.stock_page=1,1
            if family.alive then self:start() else self:body(false) end
        end,true,1.26)
        ui:button(1550,389,880,84,#families<HOME_SLOTS and "Новый организм" or "Управление слотами",new,false,1)
    else
        ui:surface(735,590,300,300,"card")
        ui:text(735,590,"+",2.0,ui.colors.dim,nil,true)
        ui:text(1110,705,"Свободный слот",1.5,ui.colors.pale)
        ui:text(1110,619,"Выбери форму для нового забега.",1,ui.colors.dim)
        ui:button(1550,490,880,106,"Новый организм",new,true,1.20)
    end
    local buttons={
        {"Семьи",function() self:show_families() end},
        {"Геном",function() Panels.legacy(self) end},
        {"Кодекс",function() Panels.catalog(self) end},
        {"Помощь",function() self:help() end},
        {self.updater.state=="ready" and "Обновить игру" or "Обновления",function() self:updates() end},
        {"Выход",function() sys.exit(0) end},
    }
    for i,button in ipairs(buttons) do
        ui:button(1230+(i-3.5)*358,129,342,86,button[1],button[2],false,.94)
    end
end

function App:show_families()
    self:overlay("families")
    self.close_current=function() self:show_home() end
    self.audio:stop()
    self.sim=nil
    self.hud:clear()
    self.metrics=nil
    if not self.home_world then self.home_world=Simulation.new(14481) end
    self.scene:render(self.home_world)
    gui.set_enabled(self.cover,false)
    local ui = self.modal
    ui:box(1230,540,2460,1080,vmath.vector4(.015,.035,.05,.65))
    local groups={alive={},ancestral={}}
    for _,family in ipairs(self.store:family_summaries()) do
        local list=groups[family.alive and "alive" or "ancestral"]
        list[#list+1]=family
    end
    self.family_pages=self.family_pages or {}
    local populated=#groups.alive+#groups.ancestral>0
    local card_height=populated and 550 or 470
    local lower=(1080-(card_height+245))/2
    local upper=lower+card_height+175
    ui:text(1230,upper+25,"МИКРОГЕН · Семьи",1.25,ui.colors.mint,nil,true)
    local function family_group(group,x,heading,empty)
        local list=groups[group]
        local index=math.min(math.max(1,self.family_pages[group] or 1),math.max(1,#list))
        local y=lower+126+card_height/2
        local top=y+card_height/2
        local family=list[index]
        ui:surface(x,y,829,card_height)
        ui:text(x-389,top-43,heading,1,ui.colors.mint)
        if family then
            local profile=family_profile(self.store,family.id)
            local current_form=Legacy.FORMS[profile.legacy.selected_form] or Legacy.FORMS[family.form]
            portrait(ui,x-275,top-192,77,family_recipe(profile,family.form))
            ui:text(x-155,top-103,family.name,1,ui.colors.mint)
            ui:text(x-155,top-150,current_form.name.." форма",.83,ui.colors.dim)
            ui:text(x-155,top-195,("Поколение %d · жизни %d"):format(family.generation,family.runs),.83,ui.colors.dim)
            ui:text(x-155,top-239,("Ядра %d · рекорд %d с"):format(family.cores,math.floor(family.best)),.83,ui.colors.dim)
            ui:text(x-155,top-280,family.best_stage>0 and ("Пройдена ступень · "..family.best_stage) or "Лестница ещё не пройдена",.83,Interface.color("cdb5e8"))
            local status=family.alive and "Жизнь сохранена · один наследник" or (family.ended and "Жизнь завершена · новый наследник" or "Готова к первой жизни · сохранения нет")
            ui:text(x-389,top-337,status,.83,ui.colors.dim)
            ui:button(x-195,top-406,379,75,family.alive and "Продолжить" or "Подготовить",function()
                if not self.store:select_family(family.id) then return self:notice(self.store.last_error) end
                self.equipment_state=nil
                self.body_page,self.stock_page=1,1
                if family.alive then self:start() else self:body(false) end
            end,true,.83)
            ui:button(x+195,top-406,379,75,"Удалить…",function() self:delete_family(family) end,false,.83)
        else
            ui:text(x-389,y,empty,.83,ui.colors.dim,760)
        end
        local function move(delta)
            return function()
                self.family_pages[group]=index+delta
                self:show_families()
            end
        end
        local pager=y-card_height/2+58
        ui:button(x-311,pager,156,75,"‹",index>1 and move(-1) or nil,false,.83)
        ui:text(x,pager,("%d / %d"):format(family and index or 0,#list),.83,ui.colors.dim,nil,true)
        ui:button(x+311,pager,156,75,"›",index<#list and move(1) or nil,false,.83)
    end
    family_group("alive",804,"Живые организмы","Нет живых организмов.\nСоздайте новую семью.")
    family_group("ancestral",1656,"Семьи · подготовка","Здесь появятся семьи\nдля следующего поколения.")
    ui:button(1230,lower+76,1680,75,"Главное меню",function() self:show_home() end,true,.83)
    local buttons={
        {"Геном",function() Panels.legacy(self) end},
        {"Кодекс",function() Panels.catalog(self) end},
        {"Помощь",function() self:help() end},
        {self.updater.state=="ready" and "Обновить игру" or "Обновления",function() self:updates() end},
        {"Выход",function() sys.exit(0) end},
    }
    for i,button in ipairs(buttons) do ui:button(1230+(i-3)*340,lower-14,319,75,button[1],button[2],false,.83) end
    ui:text(1230,lower-79,"Версия "..sys.get_config_string("project.version","0.3.0").." · игра без интернета",.83,ui.colors.pale,nil,true)
end

function App:new_family()
    if #self.store.profile.families.items>=HOME_SLOTS then return self:show_families() end
    self:overlay("new_family")
    local ui=self.modal
    local left=ui:panel("Новое семейство","Выбери базовую форму. Прежние семейства и их жизни сохранятся.",function() self:show_home() end,1650)
    ui:text(left+33,842,"Форма задаёт тело и мягкое предпочтение органов.",.83,ui.colors.dim)
    for i,id in ipairs(Legacy.FORM_IDS) do
        local data=Legacy.FORMS[id]
        local x=1230+(i-2)*529
        ui:surface(x,526,511,578)
        portrait(ui,x,645,120,family_recipe(nil,id))
        ui:text(x-228,488,data.name,1,ui.colors.mint)
        ui:text(x-228,390,data.desc,.83,ui.colors.dim,456)
        ui:button(x,287,455,75,"Выбрать",function()
            local generated_name="Семейство "..self.store.profile.families.next_id
            if not self.store:create_family(generated_name,id) then return self:notice(self.store.last_error) end
            self.home_slot=nil
            self.equipment_state=nil
            self.body_page,self.stock_page=1,1
            self:body(false)
        end,true,.83)
    end
    ui:button(1230,183,1584,75,"Назад",function() self:show_home() end,false,.83)
end

function App:delete_family(family)
    self:overlay("family_delete")
    local ui=self.modal
    local left=ui:panel("Удалить "..family.name.."?","Удалятся сохранённая жизнь, органы, материалы и наследие только этого семейства.",
        function() self:show_home() end,1275)
    ui:text(left+33,807,"Другие семейства сохранятся. Это действие нельзя отменить.",1,ui.colors.pale,1200)
    ui:button(923,696,570,84,"Оставить",function() self:show_home() end,true)
    ui:button(1537,696,570,84,"Удалить семейство",function()
        if not self.store:delete_family(family.id) then return self:notice(self.store.last_error) end
        self.home_slot=nil
        self:show_home()
    end)
end

function App:help()
    self:overlay("help")
    local ui=self.modal
    local left=ui:panel("Как выжить в капле","Движение — единственное действие во время боя.",function() self:show_home() end,1275)
    local tips={
        "Коснись любого свободного места экрана и веди палец: появится джойстик.",
        "На ПК: WASD или стрелки. M — карта, E — колония, B — развитие, Esc — пауза.",
        "Зелёные фрагменты ДНК повышают уровень. Биомасса нужна для покупок и переброса мутаций. Органиум дают за боссов, минибоссов и завершение забега.",
        "Касание захватывает пищу: можно плыть дальше, пока она переваривается. Рецепторы открывают притягивание. Бирюзовые кусочки лечат.",
        "Рост меняет соотношение сил: бывшие хищники становятся пищей. У босса после залпа открывается ядро.",
        "Собирай пары органов: щупальца + кислота, шипы + импульс, деление + след, заражение + пасть.",
        "Посети гнёзда и победи местных минибоссов, чтобы открыть маршрут к боссу ступени.",
        "Игра сохраняет забег при паузе и уходе в фон. В меню можно продолжить сохранённую жизнь.",
    }
    for i,tip in ipairs(tips) do ui:text(left+33,820-(i-1)*84,"• "..tip,.83,Interface.color("b8d0cd"),1209) end
    ui:button(1230,135,1209,84,"Понятно",function() self:show_home() end,true)
end

function App:updates()
    self:overlay("updates")
    local ui, updater = self.modal, self.updater
    local function back() self:show_home() end
    local left = ui:panel("Обновления Микрогена", "Загрузка идёт в фоне. Установку подтверждает Android.", back)
    local label = updater.asset and updater.asset.label or ""
    local captions = {
        idle = "Игра проверяет новые версии Defold автоматически.",
        checking = "Проверяем выпуски на GitHub…",
        downloading = "Загружаем и проверяем версию " .. label .. "…",
        ready = updater.needs_permission and "Разреши установку из этого приложения в настройках Android."
            or "Версия " .. label .. " готова к установке.",
        current = "У тебя актуальная стабильная версия Defold.",
        error = "Обновиться не удалось. Можно повторить проверку.",
        desktop = "Для Android доступна версия " .. label .. ".",
    }
    ui:text(left+33,828,"Установлена версия "..updater.installed,1)
    ui:text(left+33,754,captions[updater.state],.96,ui.colors.dim)
    if updater.state == "ready" then
        ui:button(1230,646,1479,84,"Открыть установщик",function() updater:install() end,true)
        if updater.needs_permission then
            ui:button(1230,545,1479,84,"Разрешение Android",function() updater.native.allow() end)
        end
    elseif updater.state ~= "checking" and updater.state ~= "downloading" then
        ui:button(1230,646,1479,84,"Проверить обновления",function() updater:check() end,true)
    end
    if not updater.needs_permission then
        ui:button(1230,545,1479,84,"Открыть выпуски на GitHub",function()
            sys.open_url("https://github.com/Magral/Microgen/releases")
        end)
    end
    ui:button(1230,447,1479,84,"Назад",back)
end

local function part_caption(part)
    return string.format("%s · Р%d · %d кл.",name(part.kind),part.rank,part.cells)
end

function App:leave_body(live)
    if not live then return self:show_home() end
    if self.sim.stage_transition then return self:stage_transition() end
    if self.development_origin=="pause" then return self:pause() end
    self:show_run()
end

function App:body(live)
    self:overlay(live and "build" or "preparation")
    local profile,ui=self.store.profile,self.modal
    local state=Equipment.from_profile(profile)
    if not state.equipped then
        self:notice("Не удалось прочитать органы семейства")
        return self:leave_body(live)
    end
    self.hud:visible(false)
    local family_name="Организм"
    for _,family in ipairs(self.store:family_summaries()) do
        if family.id==self.store:family_id() then family_name=family.name;break end
    end
    local close=function() self:leave_body(live) end
    self.close_current=close
    local form=Legacy.FORMS[state.form]
    local left=ui:panel("Организм",("%s · %s"):format(family_name,form.name),close,2220)
    local used=Slots.used_cells(state)
    local materials=profile.organ_materials or {}
    ui:text(left+33,859,("Тело %d/%d · Органиум %d · Органеллы %d · Мембраны %d · Плазма %d"):format(
        used,state.body_capacity,profile.organium or 0,materials.organelle or 0,materials.membrane or 0,materials.plasma or 0),.80,ui.colors.dim)

    local organs_x, synergies_x=left+365,left+1855
    for _,x in ipairs({organs_x,1230,synergies_x}) do ui:surface(x,570,660,505,"card") end
    ui:text(organs_x,779,"Органы",1.08,ui.colors.pale,nil,true)
    ui:text(synergies_x,779,"Синергии",1.08,ui.colors.pale,nil,true)
    ui:box(organs_x,750,580,3,ui.colors.mint)
    ui:box(synergies_x,750,580,3,ui.colors.mint)

    local function open(part,location)
        return function() self:equipment(part,location,1,live,nil,function() self:body(live) end) end
    end
    local body_pages=math.max(1,math.ceil(#state.equipped/3))
    self.body_page=math.min(self.body_page or 1,body_pages)
    local offset=(self.body_page-1)*3
    local selected
    for i=1,3 do
        local part=state.equipped[offset+i]
        if part and part.id==self.body_selected then selected=part end
    end
    selected=selected or state.equipped[offset+1]
    for i=1,3 do
        local part=state.equipped[offset+i]
        if not part then break end
        local y=686-(i-1)*79
        local current=selected==part
        ui:button(organs_x,y,598,72,"",function()
            self.body_selected=part.id
            self.body_synergy_page=1
            self:body(live)
        end,current)
        ui:image("icons","icon_"..part.kind,organs_x-245,y,55,55)
        ui:fit_text(organs_x-204,y,name(part.kind),1,current and Interface.color("09272c") or ui.colors.pale,390,57)
        ui:text(organs_x+245,y,tostring(part.rank),1.03,current and Interface.color("09272c") or ui.colors.mint,nil,true)
    end
    ui:button(organs_x-149,443,282,64,"Свойства",selected and open(selected,"equipped"),false,.9)
    ui:button(organs_x+149,443,282,64,"+ Добавить",used<state.body_capacity and function()
        self:inventory(1,live,"stock","body")
    end or nil,false,.9)
    local function pager(x,page,total,change)
        if total<=1 then return end
        ui:button(x-178,365,106,58,"‹",page>1 and function() change(page-1) end or nil)
        ui:text(x,365,page.." / "..total,.85,ui.colors.dim,nil,true)
        ui:button(x+178,365,106,58,"›",page<total and function() change(page+1) end or nil)
    end
    pager(organs_x,self.body_page,body_pages,function(page)
        self.body_page=page
        self.body_synergy_page=1
        self:body(live)
    end)

    local recipe=live and self.sim.player_genome or family_recipe(profile,state.form)
    local build=live and self.sim.build or Build.new()
    if not live then StageRewards.apply_equipment(state,build) end
    local color=live and self.sim:body_color() or Genome.colors(recipe)[1]
    local facing=live and self.sim.facing or 0
    local body=portrait(ui,1230,592,112,recipe)
    gui.set_color(body,Interface.color(color))
    gui.set_rotation(body,vmath.vector3(0,0,-math.deg(facing)))
    local anatomy=Anatomy.new(ui.group)
    ui:remember(anatomy.node)
    local preview={player_genome=recipe,build=build,facing=facing,elapsed=1,
        enemies={},pickups={},remains={},effects={},hp=1,max_hp=1,
        body_radius=function() return 112 end,body_color=function() return color end}
    Anatomy.update(anatomy,preview,1230,592,112)
    if selected then
        local spotlight=Anatomy.new(ui.group)
        ui:remember(spotlight.node)
        local kind=selected.kind
        preview.build={
            rank=function(_,id) return id==kind and build:rank(id) or 0 end,
            quality=function(_,id) return build:quality(id) end,
            evolved=function(_,id) return id==kind and build:evolved(id) end,
        }
        Anatomy.update(spotlight,preview,1230,592,112)
        gui.set_color(spotlight.node,vmath.vector4(1.25,1.25,1.25,.78))
        ui:image("icons","icon_"..kind,1005,388,50,50)
        ui:fit_text(1048,388,name(kind),.92,ui.colors.mint,394,62)
    end

    local rows=Inspector.synergy_rows(build,selected and selected.kind)
    local pages=math.max(1,math.ceil(#rows/3))
    self.body_synergy_page=math.min(self.body_synergy_page or 1,pages)
    for i=1,3 do
        local row=rows[(self.body_synergy_page-1)*3+i]
        if not row then break end
        local y=678-(i-1)*104
        ui:surface(synergies_x,y,598,94,row.related and "button" or "card")
        if row.related then ui:box(synergies_x-282,y,5,66,ui.colors.mint) end
        ui:fit_text(synergies_x-263,y+22,row.name,.92,ui.colors.pale,524,38)
        ui:fit_text(synergies_x-263,y-18,row.status,.82,row.active and ui.colors.mint or Interface.color("c4aeea"),524,42)
    end
    pager(synergies_x,self.body_synergy_page,pages,function(page)
        self.body_synergy_page=page
        self:body(live)
    end)
    ui:text(left+33,300,("Запас %d/%d мест"):format(#state.stock,state.stock_capacity),.83,ui.colors.dim)
    local stock_pages=math.max(1,math.ceil(state.stock_capacity/3))
    self.stock_page=math.min(self.stock_page or 1,stock_pages)
    local shown=math.min(3,state.stock_capacity-(self.stock_page-1)*3)
    local stock_width=(1904-(shown-1)*14)/math.max(1,shown)
    for i=1,shown do
        local index=(self.stock_page-1)*3+i
        local part=state.stock[index]
        local x=left+282+stock_width/2+(i-1)*(stock_width+14)
        ui:button(x,300,stock_width,68,part and part_caption(part) or ("+ Запас "..index),
            part and open(part,"stock") or function() self:stock_sources(live) end,false,.82)
    end
    if stock_pages>1 then
        ui:button(1030,213,122,63,"‹",self.stock_page>1 and function() self.stock_page=self.stock_page-1;self:body(live) end or nil)
        ui:text(1230,213,self.stock_page.." / "..stock_pages,.83,ui.colors.dim,nil,true)
        ui:button(1430,213,122,63,"›",self.stock_page<stock_pages and function() self.stock_page=self.stock_page+1;self:body(live) end or nil)
    end
    local actions={
        {"Назад",close},
        {"Геном",function() Panels.legacy(self,nil,nil,function() self:body(live) end) end},
        {"Сводка",function() self:build(1,"journal",live) end},
    }
    if live then actions[#actions+1]={"Мутации",function() self:build(1,"temporary",true) end} end
    if not live then
        actions[#actions+1]={"Архив",function() self:inventory(1,false,"reserve") end}
        actions[#actions+1]={"Облик",function()
            if self.store:reroll_morphology() then self:body(false) else self:notice(self.store.last_error) end
        end}
        actions[#actions+1]={"Начать жизнь",function() self:start() end,true}
    end
    local w=(2154-(#actions-1)*17)/#actions
    for i,action in ipairs(actions) do
        ui:button(left+33+w/2+(i-1)*(w+17),127,w,75,action[1],action[2],action[3],.83)
    end
end

function App:stock_sources(live)
    self:overlay("inventory")
    local ui=self.modal
    local close=function() self:body(live) end
    ui:panel("Заполнить запас","Выбери, откуда взять орган.",close,1275)
    ui:button(1230,797,1209,84,"Из тела",function() self:inventory(1,live,"equipped","stock") end)
    ui:button(1230,695,1209,84,"Из архива семейства",function() self:inventory(1,live,"reserve","stock_from_archive") end)
    ui:button(1230,593,1209,84,"К организму",close)
end

function App:inventory(page,live,group,target)
    self:overlay("inventory")
    local ui=self.modal
    local state=Equipment.from_profile(self.store.profile)
    local rows={}
    local locations={equipped="В теле",stock="В запасе",reserve="В архиве"}
    local leave=function() self:body(live) end
    local reopen=function() self:inventory(page,live,group,target) end
    for _,location in ipairs(group and {group} or {"equipped","stock","reserve"}) do
        for _,part in ipairs(state[location] or {}) do
            rows[#rows+1]={title=part_caption(part),detail=locations[location],
                label="Открыть",action=function() self:equipment(part,location,page,live,target,reopen) end}
        end
    end
    local heading=({reserve="Архив семейства",stock="Запас органов",equipped="Органы в теле"})[group] or "Органы"
    local detail=group=="reserve" and "Выбери сохранённый орган." or "Выбери орган для перестройки."
    Panels.list(ui,heading,detail,rows,page,function(next_page) self:inventory(next_page,live,group,target) end,leave)
end

function App:equipment(organ,location,page,live,target,return_to,tab)
    self:overlay("organ_detail")
    local ui = self.modal
    local leave = return_to or function() self:inventory(page,live) end
    self.close_current=leave
    local left=ui:panel(name(organ.kind),"Свойства принадлежат этому экземпляру и сохраняются в семействе.",leave,1650)
    tab=tab or "stats"
    local function change(action,...)
        local profile = self.store.profile
        local state = Equipment.from_profile(profile)
        local result
        if action=="move" then result=Equipment.move(state,organ.id,...)
        elseif action=="upgrade" then result=Equipment.upgrade(state,organ.id,profile.organium,profile.organ_materials)
        elseif action=="dismantle" then result=Equipment.dismantle(state,organ.id,profile.organium,profile.organ_materials)
        else result=Equipment.specialize(state,organ.id,...)
        end
        if not result or not result.ok then
            self:notice(result and result.error or "Изменение не удалось")
            return false
        end
        local next_profile = Copy(profile)
        next_profile.organism = result.state
        next_profile.organium = result.organium or profile.organium
        next_profile.organ_materials = result.materials or profile.organ_materials
        if live or has_checkpoint(profile) then
            local snapshot=live and self.sim:snapshot() or Copy(profile.checkpoint)
            local Build=require "main.run.build_model"
            local candidate=Build.new()
            candidate:from_dict(snapshot.build)
            StageRewards.apply_equipment(result.state,candidate)
            snapshot.build=candidate:to_dict()
            snapshot.stock_capacity=result.state.stock_capacity
            next_profile.checkpoint=snapshot
        end
        if not self.store:write_profile(next_profile) then self:notice(self.store.last_error);return false end
        if live then
            StageRewards.apply_equipment(result.state,self.sim.build)
            self.sim.stock_capacity=result.state.stock_capacity
        end
        leave()
        return true
    end
    local detail=function(section) self:equipment(organ,location,page,live,target,leave,section) end
    local function equip()
        if change("move","body") then return end
        local state=Equipment.from_profile(self.store.profile)
        local selected={}
        local function choose(next_page)
            ui:clear()
            local rows={}
            local cells=Slots.used_cells(state)+organ.cells
            for _,part in ipairs(state.equipped) do
                if selected[part.id] then cells=cells-part.cells end
                rows[#rows+1]={title=(selected[part.id] and "✓  " or "")..part_caption(part),label=selected[part.id] and "Оставить" or "Заменить",action=function()
                    selected[part.id]=not selected[part.id]
                    choose(next_page)
                end}
            end
            Panels.list(ui,"Перестройка",("Обмен · тело %d → %d/%d кл."):format(Slots.used_cells(state),cells,state.body_capacity),
                rows,next_page,choose,function() detail(tab) end)
            ui:button(1230,114,285,63,"Применить",cells<=state.body_capacity and function()
                local ids={}
                for _,part in ipairs(state.equipped) do if selected[part.id] then ids[#ids+1]=part.id end end
                change("move","body",ids)
            end or nil,true,.88)
        end
        choose(1)
    end
    ui:image("icons","icon_"..organ.kind,left+183,613,255,255)
    local locations={equipped="В теле",stock="В запасе",reserve="В архиве"}
    ui:text(left+365,825,part_caption(organ).." · "..locations[location],.95,ui.colors.mint)
    for i,item in ipairs({{"Показатели","stats"},{"Синергии","synergies"},{"Рост","growth"},{"Специализация","specialization"}}) do
        ui:button(left+480+(i-1)*329,751,313,72,item[1],tab~=item[2] and function() detail(item[2]) end or nil,false,.83)
    end
    if tab=="synergies" then
        local build=live and self.sim.build or require("main.run.build_model").new()
        if not live then StageRewards.apply_equipment(Equipment.from_profile(self.store.profile),build) end
        ui:text(left+332,582,Inspector.synergy_summary(build,organ.kind),.88,ui.colors.mint,1260)
    elseif tab=="growth" then
        local cost=Equipment.upgrade_cost(organ)
        ui:text(left+332,638,("Следующий ранг · %d органиума + %d органелл"):format(cost,Equipment.upgrade_ingredient(organ)),.88)
        ui:button(left+619,548,574,75,("Улучшить · ранг %d → %d"):format(organ.rank,organ.rank+1),function() change("upgrade") end,true,.87)
    elseif tab=="specialization" then
        local profile=self.store.profile
        local active=Catalog.specialization_data(organ.kind,organ.specialization or "")
        ui:text(left+332,655,"Активная ветвь: "..(active.name or "Нет"),.9,ui.colors.mint)
        for i,option in ipairs(Catalog.SPECIALIZATIONS[organ.kind] or {}) do
            local y=606-(i-1)*141
            ui:text(left+332,y,option.name,.86,Interface.color(option.color))
            ui:text(left+332,y-55,option.desc,.76,ui.colors.dim,890)
            ui:button(left+1450,y-16,328,65,option.id==organ.specialization and "Активна" or "Выбрать",option.id~=organ.specialization and function()
                change("specialize",option.id,profile.organium,profile.organ_materials)
            end or nil,true,.83)
        end
    else
        ui:text(left+332,622,Catalog.effect_text(organ.kind,organ.rank),.95,ui.colors.mint,1250)
        ui:text(left+332,535,Catalog.item(organ.kind).desc,.87,ui.colors.pale,1250)
    end
    local actions={
        {"Назад",leave},
        {"Кодекс",function() Panels.catalog(self,"organs",1,function() detail(tab) end,organ.kind) end},
        {"Расщепить",function()
            self:overlay("organ_detail")
            self.close_current=function() detail(tab) end
            ui:panel("Расщепить орган?","Ранг и орган будут потеряны.",function() detail(tab) end,1275)
            ui:button(927,723,578,84,"Оставить",function() detail(tab) end,true)
            ui:button(1533,723,578,84,"Расщепить",function() change("dismantle") end)
        end},
    }
    if location~="equipped" then actions[#actions+1]={"В тело",equip,true} end
    if location=="equipped" or location=="reserve" then
        local destination=location=="equipped" and "stock" or "stock_from_archive"
        actions[#actions+1]={"В запас",function() change("move",target or destination) end}
    else
        actions[#actions+1]={"В архив",function() change("move","archive") end}
    end
    local w=(2154-(#actions-1)*17)/#actions
    for i,action in ipairs(actions) do
        ui:button(left+33+w/2+(i-1)*(w+17),127,w,75,action[1],action[2],action[3],.83)
    end
end

function App:save_run()
    local sim = self.sim
    if not sim then return true end
    local profile = Copy(self.store.profile)
    local snapshot = sim:snapshot()
    local source = self.equipment_state
    if source then profile.organism=source end
    local state,err = StageRewards.capture_equipment(profile,snapshot.build)
    if not state then self:notice(err);return false end
    profile.organism,profile.checkpoint=state,snapshot
    local discovered={}
    for _,id in ipairs(profile.discovered) do discovered[id]=true end
    for _,ids in ipairs({Catalog.ORGAN_IDS,Catalog.ADAPTATION_IDS}) do
        for _,id in ipairs(ids) do
            if sim.build:rank(id)>0 and not discovered[id] then profile.discovered[#profile.discovered+1]=id end
        end
    end
    local synergy_known={}
    for _,id in ipairs(profile.synergies) do synergy_known[id]=true end
    for _,id in ipairs(sim.build:active_synergies()) do
        if not synergy_known[id] then profile.synergies[#profile.synergies+1]=id end
    end
    local result=self.store:write_profile(profile)
    if result then self.equipment_state=nil else self:notice(self.store.last_error) end
    return result
end

function App:start(seed)
    if self.store:family_id()=="" then
        if not self.store:create_family("Организм","predator") then return self:notice(self.store.last_error) end
    end
    local profile = self.store.profile
    if has_checkpoint(profile) then
        self.sim = Simulation.restore(profile.checkpoint)
        if not self.sim then return self:notice("Не удалось открыть сохранение") end
    else
        if not Legacy.can_start(profile) then
            Panels.legacy(self,"imprint",1)
            return self:notice("Выбери отпечаток, чтобы открыть новое поколение")
        end
        seed = seed or math.floor(socket.gettime()*1000)%2147483647
        local loadout = Legacy.loadout(profile)
        self.sim = Simulation.new(seed,profile.unlocked,profile.upgrades,loadout.branch,loadout)
        self.sim.family_id = self.store:family_id()
        self.sim.best_stage = profile.best_stage or 0
        local equipment = Equipment.from_profile(profile)
        StageRewards.apply_equipment(equipment,self.sim.build)
        self.sim.stock_capacity = equipment.stock_capacity
    end
    self.save_time=0
    self.equipment_state=nil
    self:show_run()
    self:save_run()
    self:notice("Веди палец по свободной части экрана")
    print("MICROGEN RUN READY " .. tostring(self.sim.world.seed_value))
end

local function safe_edges()
    local w,h=window.get_size()
    local area=window.get_safe_area()
    if not area or w<=0 or h<=0 then return 42,2418,1047,33 end
    local ratio=math.min(w/WIDTH,h/HEIGHT)
    return 42+(area.inset_left or 0)/ratio,2418-(area.inset_right or 0)/ratio,
        1047-(area.inset_top or 0)/ratio,33+(area.inset_bottom or 0)/ratio
end

function App:show_run()
    self:overlay("run")
    gui.set_enabled(self.cover,false)
    local ui=self.hud
    ui:clear()
    local left,right,top,bottom=safe_edges()
    local control_x=right-144
    local color=Interface.color
    self.stage=ui:text(left,top-12,"",.90,color("9bbfbb"))
    self.area=ui:text(left,top-52,"",.84,color("9bbfbb"))
    self.goal=ui:text(left,top-88,"",.84,ui.colors.gold)
    self.health=ui:meter(left,top-128,360,21,color("78d9bd"))
    self.xp=ui:meter(left,top-149,360,9,color("ba99e4"))
    self.shield_metric=ui:text(left,top-181,"",.82,color("b5d5ff"))
    local shield_base=ui:box(left+180,top-207,360,7,color("193540"))
    local shield=ui:box(left,top-207,360,7,color("8ebcf4"))
    gui.set_pivot(shield,gui.PIVOT_W)
    self.shield,self.shield_base=shield,shield_base
    self.level=ui:text(left,top-246,"",.96,ui.colors.pale)
    self.biomass=ui:text(left,top-290,"",.91,ui.colors.pale)
    self.last_damage=ui:text(left,top-333,"",.79,ui.colors.red)
    self.metrics=ui:text(left,bottom+11,"",.73,color("a5d6ce"))
    if not self.minimap then self.minimap=Minimap.new(self.sim.world) end
    ui:surface(control_x,top-105,288,210,"panel")
    local mini=ui:box(control_x,top-105,266,188,vmath.vector4(1,1,1,1))
    self.minimap:attach(mini)
    ui:button(control_x,top-251,288,66,"Карта",function() self:map() end)
    ui:button(control_x,top-350,288,81,"Организм",function()
        self.development_origin=nil
        self:body(true)
    end)
    ui:button(control_x,bottom+47,288,75,"Ⅱ  Пауза",function() self:pause() end)
    self.reward_x,self.reward_y=control_x,top-446
    self.reward_button=false
    self.colony_label=ui:button(1230,bottom+83,420,81,"Войти в колонию",function()
        local index=self.sim:nearby_colony()
        if index>0 then self:colony(index) end
    end,true)
    self:draw_hud()
end

function App:draw_hud()
    local sim=self.sim
    local health=math.min(1,math.max(0,sim.hp/math.max(1,sim.max_hp)))
    local xp=math.min(1,math.max(0,sim.xp/sim:xp_needed()))
    gui.set_size(self.health,vmath.vector3(math.max(.01,360*health),21,0))
    gui.set_size(self.xp,vmath.vector3(math.max(.01,360*xp),9,0))
    gui.set_text(self.stage,string.format("СТУПЕНЬ %d · %s",sim.stage_index,sim:stage_name()))
    local biome=sim.world:biome(sim.player.x,sim.player.y)
    gui.set_text(self.area,(biome==1 and "ПИТАТЕЛЬНАЯ СРЕДА" or "ТОКСИЧНАЯ ЗОНА").." · "..sim.world:condition_name(biome))
    local elapsed=sim.elapsed
    gui.set_text(self.level,string.format("Размер ×%.1f · Ур. %d · %.0f/%.0f HP",sim:body_radius()/22,sim.level,sim.hp,sim.max_hp))
    gui.set_text(self.biomass,string.format("Биомасса %d · %d:%02d",sim.build.biomass,math.floor(elapsed/60),math.floor(elapsed)%60))
    local nests=0
    for _,nest in ipairs(sim.world.nests) do if nest.used then nests=nests+1 end end
    local miniboss_target=sim:stage_miniboss_target()
    local goal=sim.boss_spawned and ("ГЛАВНАЯ УГРОЗА: "..sim:boss_title())
        or string.format("ЦЕЛЬ: гнёзда %d/%d · минибоссы %d/%d",nests,math.min(4,miniboss_target*2),sim.minibosses_defeated or 0,miniboss_target)
    gui.set_text(self.goal,goal)
    local barrier=sim.build:rank("barrier")>0
    gui.set_enabled(self.shield,barrier)
    gui.set_enabled(self.shield_base,barrier)
    if barrier then
        local cooldown=sim.cooldowns.barrier or 0
        gui.set_text(self.shield_metric,cooldown<=0 and string.format("Щит готов · до %.0f урона",sim:barrier_capacity())
            or string.format("Щит восстанавливается · %.1f с",cooldown))
        gui.set_size(self.shield,vmath.vector3(math.max(.01,360*(1-math.min(1,cooldown/8))),7,0))
    else gui.set_text(self.shield_metric,"") end
    self.minimap:update(sim)
    Interface.button_enabled(self.colony_label,sim:nearby_colony()>0)
    local damage=sim.last_damage or {}
    gui.set_text(self.last_damage,damage.name and string.format("Последний урон: −%.1f HP · %s",damage.amount or 0,damage.name) or "")
end

function App:pause()
    local ui,sim=self.modal,self.sim
    self:overlay("pause")
    local back=function() self:show_run() end
    self.close_current=back
    self:save_run()
    ui:panel("Пауза","Организм ждёт. Бой и время остановлены.",back,1080)
    local function toggle(key)
        local profile=Copy(self.store.profile)
        profile[key]=not self[key]
        if self.store:write_profile(profile) then self[key]=profile[key]
        else self:notice(self.store.last_error) end
        self:pause()
    end
    ui:button(1230,786,964,84,"Продолжить",back,true)
    ui:button(1230,690,964,84,"Развитие · сборка",function()
        self.development_origin="pause"
        self:body(true)
    end)
    ui:button(1230,594,964,84,"Карта микромира",function() self:map(true) end)
    ui:button(1230,498,964,84,self.audio_enabled and "Звук · вкл." or "Звук · выкл.",function() toggle("audio_enabled") end)
    ui:button(1230,402,964,84,self.show_metrics and "Показ FPS · вкл." or "Показ FPS · выкл.",function() toggle("show_metrics") end)
    ui:button(1230,306,964,84,"Сохранить и выйти в меню",function()
        if self:save_run() then self.sim=nil;self:show_home() end
    end)
    ui:text(1230,187,("Seed %d · %s"):format(sim.world.seed_value,sim.run_id),.75,ui.colors.dim,nil,true)
end

function App:map(from_pause)
    self:overlay("map")
    local leave=from_pause and function() self:pause() end or function() self:show_run() end
    self.close_current=leave
    local ui,sim = self.modal,self.sim
    local world = sim.world
    local tile = 17
    local top,left = 777,1230-world.w*tile/2
    ui:panel("Карта", sim:stage_name(),leave)
    for row=0,world.h-1 do
        local col=0
        while col<world.w do
            local start=col
            local function terrain(x)
                local i=row*world.w+x+1
                return not sim.explored[i] and 0 or world.cells[i]==1 and 1 or 2
            end
            local ground=terrain(col)
            repeat col=col+1 until col==world.w or terrain(col)~=ground
            local color=ground==2 and vmath.vector4(.20,.44,.42,1)
                or ground==1 and vmath.vector4(.065,.16,.19,1) or vmath.vector4(.02,.065,.08,1)
            ui:box(left+tile*(start+col)/2,top-tile*(row+.5),(col-start)*tile,tile,color)
        end
    end
    local function mark(p,color,r)
        ui:box(left+p.x*tile/world.tile_size,top-p.y*tile/world.tile_size,r,r,color)
    end
    for _,colony in ipairs(world.colonies) do if colony.visited then mark(colony.pos,ui.colors.mint,10) end end
    for _,nest in ipairs(world.nests) do
        local i=math.floor(nest.pos.y/world.tile_size)*world.w+math.floor(nest.pos.x/world.tile_size)+1
        if sim.explored[i] and not nest.used then mark(nest.pos,ui.colors.gold,10) end
    end
    if sim.boss_spawned then mark(sim.boss_marker or world.boss_pos,ui.colors.red,15) end
    mark(sim.player,ui.colors.pale,16)
end

function App:build(page,tab,live)
    if live==nil then live=self.sim~=nil end
    local ui,sim=self.modal,self.sim
    if not live then
        local loadout=Legacy.loadout(self.store.profile)
        sim=Simulation.new(loadout.seed,self.store.profile.unlocked,self.store.profile.upgrades,loadout.branch,loadout)
        StageRewards.apply_equipment(Equipment.from_profile(self.store.profile),sim.build)
    end
    tab = tab or "organs"
    self:overlay("build")
    local rows = {}
    local heading
    if tab=="synergies" then
        for _,data in ipairs(Inspector.synergy_rows(sim.build)) do
            rows[#rows+1] = {title=data.title,detail=data.requirements,
                color=data.active and ui.colors.mint or ui.colors.pale,action=function()
                    self:overlay("build")
                    local left=ui:panel(data.title,data.requirements,function() self:build(page,tab,live) end)
                    ui:text(left+64,580,data.description,1.02,ui.colors.pale,1430)
                end}
        end
    elseif tab=="temporary" then
        heading="Действуют в текущей жизни"
        for _,id in ipairs(Catalog.TEMP_MUTATION_IDS) do
            local rank=sim.build:temporary_mutation_rank(id)
            if rank>0 then
                local mutation=Catalog.TEMP_MUTATIONS[id]
                rows[#rows+1]={title=mutation.name.." · "..rank,detail=mutation.summary}
            end
        end
    elseif tab=="journal" then
        local journal=CombatStats.journal(sim.combat_stats,sim.elapsed)
        heading=journal.summary
        for _,row in ipairs(journal.sources) do rows[#rows+1]=row end
        for _,row in ipairs(journal.history) do rows[#rows+1]=row end
    else
        local ids = tab=="organs" and Catalog.ORGAN_IDS or Catalog.ADAPTATION_IDS
        for _,id in ipairs(ids) do
            local rank=sim.build:rank(id)
            if rank>0 then rows[#rows+1]={title=name(id).."  ·  "..rank,detail=Inspector.effect_text(sim.build,id,sim:ability_scale(),sim:cooldown_factor())} end
        end
    end
    local back=function() self:body(live) end
    self.close_current=back
    Panels.list(ui,"Сводка организма",heading or sim:stage_name(),rows,page,function(p) self:build(p,tab,live) end,back)
    ui:button(1100,822,195,46,"Ячейки",back)
    ui:button(1305,822,172,46,"Органы",function() self:build(1,"organs",live) end)
    ui:button(1512,822,223,46,"Адаптации",function() self:build(1,"passives",live) end)
    ui:button(1733,822,205,46,"Синергии",function() self:build(1,"synergies",live) end)
    ui:button(1946,822,198,46,"Журнал",function() self:build(1,"journal",live) end)
end

function App:award(id,replace_id,grade)
    local state = self.equipment_state
    if not state then
        state=StageRewards.capture_equipment(self.store.profile,self.sim.build:to_dict())
    end
    if not state then return false end
    local result
    if replace_id and replace_id~="" then
        local draft=Equipment.draft_exchange(state,id,grade)
        if not draft.ok then return false end
        local replacements={}
        for _,organ in ipairs(state.equipped) do
            if organ.kind==replace_id then replacements[1]=organ.id;break end
        end
        if #replacements==0 then return false end
        result=Equipment.move(draft.state,draft.id,"body",replacements)
    else
        result=Equipment.award(state,id,grade)
    end
    if not result.ok then self:notice(result.error);return false end
    self.equipment_state=result.state
    StageRewards.apply_equipment(result.state,self.sim.build)
    self.sim.stock_capacity=result.state.stock_capacity
    if result.location=="reserve" then
        self.sim.pending_inventory[#self.sim.pending_inventory+1]=result.id
    end
    if result.location=="stock" or result.location=="reserve" then
        self:notice(name(id)..(result.location=="stock" and " · в запасе" or " · в архиве"))
    end
    return true
end

function App:accepted(before)
    if not self:save_run() then return self:show_run() end
    local known={}
    for _,id in ipairs(before) do known[id]=true end
    local activated={}
    for _,id in ipairs(self.sim.build:active_synergies()) do
        if not known[id] then activated[#activated+1]=id end
    end
    if #activated==0 then return self:show_run() end
    for _,id in ipairs(activated) do self.sim:_effect(id,self.sim.player,self.sim:body_radius()*1.9,2.1) end
    local ui=self.modal
    self:overlay("synergy")
    local first=Catalog.SYNERGIES[activated[1]]
    ui:panel("Синергия пробудилась",first.name)
    ui:text(521,624,first.desc,1.13,ui.colors.pale,1430)
    ui:button(1230,343,630,103,"Продолжить",function() self:show_run() end,true)
end

function App:replacement(id,apply,back)
    local ui = self.modal
    self:overlay("replace")
    local rows = {}
    local ids=Catalog.ORGANS[id] and Catalog.ORGAN_IDS or Catalog.ADAPTATION_IDS
    for _,old in ipairs(ids) do
        if self.sim.build:rank(old)>0 and old~=id then
            rows[#rows+1]={title=name(old),detail="Освободить место",label="Заменить",action=function()
                local result=apply(old)
                if result then self:save_run();self:show_run() else self:notice("В теле недостаточно свободных ячеек") end
            end}
        end
    end
    local function page(p)
        ui:clear()
        Panels.list(ui,"Освободи ячейку",name(id),rows,p,page,back)
    end
    page(1)
end

function App:defer_choices()
    self.deferred_choices=true
    self:save_run()
    self:show_run()
end

function App:open_pending()
    self.deferred_choices=false
    local sim=self.sim
    local id=sim.pending_inventory[1]
    if id then
        for _,part in ipairs(Equipment.from_profile(self.store.profile).reserve) do
            if part.id==id then
                self:overlay("inventory_review")
                local close=function() self:defer_choices() end
                self.close_current=close
                local ui=self.modal
                ui:panel("Запас заполнен","Находка сохранена в архиве семейства",close)
                ui:image("icons","icon_"..part.kind,1230,677,218,218)
                ui:text(1230,526,part_caption(part),1.05,ui.colors.mint,nil,true)
                ui:button(946,391,520,88,"Управление",function()
                    self:equipment(part,"reserve",1,true,nil,function() self:open_pending() end)
                end,true)
                ui:button(1514,391,520,88,"Оставить в архиве",function()
                    table.remove(sim.pending_inventory,1)
                    self:save_run()
                    self:open_pending()
                end)
                return
            end
        end
        table.remove(sim.pending_inventory,1)
        return self:open_pending()
    end
    if #sim.reward_queue>0 then self:reward()
    elseif sim.pending_levels>0 then self:level_up()
    else self:show_run() end
end

function App:level_up()
    local ui,sim=self.modal,self.sim
    self:overlay("level")
    self.deferred_choices=false
    self.close_current=function() self:defer_choices() end
    ui:panel("Мутация · уровень "..sim.level,"Выбери одно улучшение · Биомасса "..sim.build.biomass,self.close_current,2070)
    local choices=sim:prepare_offers()
    local shaped={}
    for _,entry in ipairs(choices or {}) do
        local id=type(entry)=="string" and entry or entry.id
        if id then
            local current=sim.build:stored_rank(id)
            local grade=(sim.offer_quality or {})[id] or 0
            local gain=Catalog.ORGANS[id] and Catalog.duplicate_rank_gain(grade) or 1
            local rank=current==0 and 1 or math.min(Catalog.max_rank(id),current+gain)
            local quality=({ "Обычная", "Редкая", "Эпическая", "Легендарная" })[grade+1]
            local baseline=Catalog.effect_text(id,Catalog.effective_rank(rank))
            local rank_text=current==0 and "Ранг 1" or ("Ранг %d → %d"):format(current,rank)
            local hint
            for _, synergy_id in ipairs(Catalog.SYNERGY_IDS) do
                local synergy=Catalog.SYNERGIES[synergy_id]
                local first,second=synergy.needs[1],synergy.needs[2]
                if id==first or id==second then
                    local partner=id==first and second or first
                    local ready=sim.build:rank(partner)>0
                    hint=ready and ("✓ "..synergy.name) or ("◇ Нужен: "..Catalog.item(partner).name)
                    if ready then break end
                end
            end
            shaped[#shaped+1]={id=id,rank=rank,grade=grade,meta=rank_text.." · "..quality,detail=baseline,
                extra=hint,action=current>0 and "Усилить" or "Выбрать"}
        end
    end
    Panels.offer_cards(ui,shaped,554,function(item)
        local before=Copy(sim.build:active_synergies())
        local function apply(old)
            return sim:choose_mutation(item.id,old,function(...) return self:award(...) end)
        end
        if not apply() then self:replacement(item.id,apply,function() self:level_up() end)
        else self:accepted(before) end
    end)
    if #shaped==0 then
        ui:button(1230,530,650,97,"Получить 15 биомассы",function()
            if sim:take_level_biomass() then self:save_run();self:show_run() end
        end,true)
    end
    local used=sim.rerolls or 0
    if used<3 then
        local price=5+5*used
        local function reroll(focused)
            if sim:reroll_offers(focused) then self:save_run();self:level_up()
            else self:notice("Недостаточно биомассы или новых вариантов") end
        end
        ui:button(966,182,450,76,"Переброс · "..price,function() reroll(false) end)
        ui:button(1494,182,450,76,"Ветвь · "..(price+5),function() reroll(true) end)
    end
end

function App:colony(index)
    local ui,sim=self.modal,self.sim
    local site=sim.world.colonies[index]
    self:overlay("colony")
    ui:panel("Колония",string.format("Биомасса · %d",sim.build.biomass),function() self:show_run() end,2070)
    local items={}
    for stock_index,entry in ipairs(site.stock or {}) do
        items[#items+1]={title=entry.id=="heal" and "Восстановление" or name(entry.id),id=entry.id,
            index=stock_index,grade=entry.quality or 0,action=entry.sold and "Куплено" or "Купить",
            detail=entry.id=="heal" and "Восстанавливает здоровье" or Catalog.effect_text(entry.id,sim.build:rank(entry.id)+1),
            extra="Цена "..entry.price,sold=entry.sold}
    end
    ui:cards(items,552,function(item)
        if item.sold then return end
        local ok=sim:buy_colony(index,item.index,nil,function(...) return self:award(...) end)
        if ok then self:save_run();self:colony(index)
        else self:notice("Покупка недоступна") end
    end)
end

function App:reward(skip_animation)
    local ui,sim=self.modal,self.sim
    local reward=sim:prepare_reward()
    if #reward==0 then return self:show_run() end
    local tier=sim.reward_queue[1].tier or 1
    local caption=({"Редкая циста","Эпическая циста","Легендарная циста"})[math.min(3,tier)] or "Циста"
    if not skip_animation and self.last_reveal~=sim.reward_queue[1].token then
        self.last_reveal=sim.reward_queue[1].token
        self:overlay("reveal")
        ui:panel(caption,"Раскрывается мембрана")
        local palette=({vmath.vector4(.46,.78,1,1),vmath.vector4(.76,.53,.97,1),ui.colors.gold})[math.min(3,tier)]
        local core=ui:image("cells","surge",1230,589,406,406)
        gui.set_color(core,palette)
        local shell_left=ui:image("collectibles","cyst_"..tier.."_left",1150,589,160,320)
        local shell_right=ui:image("collectibles","cyst_"..tier.."_right",1310,589,160,320)
        local inner=ui:image("cells","speck",1230,589,120,120)
        gui.set_color(inner,vmath.vector4(palette.x,palette.y,palette.z,0))
        local icons={}
        for i=1,5 do
            local x=1230+(i-3)*205
            ui:surface(x,337,149,127,"card")
            icons[i]=ui:image("icons","icon_tentacle",x,337,124,124)
            if i~=3 then gui.set_color(icons[i],vmath.vector4(1,1,1,.43)) end
        end
        local text=ui:text(1230,746,caption,.97,palette,nil,true)
        ui:button(1230,208,440,70,"Раскрыть сразу",function() self:reward(true) end,true)
        self.reveal={time=0,core=core,inner=inner,icons=icons,shell_left=shell_left,shell_right=shell_right,
            palette=palette,caption=caption,text=text}
        return
    end
    self.reveal=nil
    self:overlay("reward")
    self.close_current=function() self:defer_choices() end
    ui:panel(caption,"Выбери одну награду",self.close_current,2070)
    Panels.offer_cards(ui,reward or {},550,function(item,index)
        local before=Copy(sim.build:active_synergies())
        local function apply(old)
            return sim:claim_reward(index,old,function(...) return self:award(...) end)
        end
        if not apply() then self:notice("Награда недоступна")
        else self:accepted(before) end
    end)
end

function App:stage_transition()
    local ui,sim=self.modal,self.sim
    self:overlay("stage")
    local boss = sim.boss_reward or {}
    if boss.organ and not boss.claimed then
        ui:panel("Главная угроза повержена",boss.name or sim:boss_title())
        local parts=sim:boss_reward_materials()
        ui:text(556,693,"Легендарный орган · "..name(boss.organ),1.15,ui.colors.gold)
        local function claim(take_organ)
            local ok,err=StageRewards.claim_boss_reward(self.store,sim,take_organ)
            if ok then self:stage_transition() else self:notice(err or self.store.last_error) end
        end
        ui:button(1230,565,805,93,"Забрать орган",function() claim(true) end,true)
        ui:button(1230,458,805,93,"Расщепить ткани",function() claim(false) end)
        ui:text(828,367,string.format("Органеллы +%d  ·  Мембрана +%d  ·  Плазма +%d",parts.organelle,parts.membrane,parts.plasma),.87,ui.colors.dim)
        ui:button(1230,258,805,83,boss.rerolled and "Переброс использован" or ("Переброс · "..StageRewards.BOSS_REROLL_COST.." органиума"),function()
            local ok,err=StageRewards.reroll_boss_reward(self.store,sim)
            if ok then self:stage_transition() else self:notice(err or self.store.last_error) end
        end)
    else
        local seed=math.max(1,sim.pending_stage_seed)
        local stage=sim.stage_index+1
        if self.briefed_seed~=seed then
            self.briefed_seed=seed
            self.screen="briefing_roll"
            ui:panel("Формируется следующая область","Ступень "..stage)
            local dial=ui:image("cells","surge",1230,569,335,335)
            local caption=ui:text(826,340,"Сканирование среды",1.13,ui.colors.mint)
            ui:button(1230,214,390,65,"Показать",function() self.briefing=nil;self:stage_transition() end)
            self.briefing={time=0,dial=dial,caption=caption,seed=seed,stage=stage}
            return
        end
        local preview=Simulation.new(seed)
        local next_world=preview.world
        preview.stage_index=stage
        preview:_create_cysts()
        local counts={0,0,0}
        for _,item in ipairs(preview.cysts) do counts[item.tier]=counts[item.tier]+1 end
        local attack=sim:boss_attack(stage,seed)
        ui:panel("Переход на ступень "..stage,sim:stage_name(stage,seed),nil,1840)
        local map_x,map_y,tile=382,793,12
        ui:surface(map_x+next_world.w*tile/2,map_y-next_world.h*tile/2,
            next_world.w*tile+32,next_world.h*tile+32,"card")
        for row=0,next_world.h-1 do
            local col=0
            while col<next_world.w do
                local start=col
                local block=next_world.cells[row*next_world.w+col+1]
                repeat col=col+1 until col==next_world.w or next_world.cells[row*next_world.w+col+1]~=block
                local ground=block==0 and Interface.color("3b716d") or Interface.color("142f3a")
                ui:box(map_x+tile*(start+col)/2,map_y-tile*(row+.5),(col-start)*tile,tile,ground)
            end
        end
        local function mark(pos,color)
            ui:box(map_x+pos.x/next_world.tile_size*tile,map_y-pos.y/next_world.tile_size*tile,12,12,color)
        end
        for _,item in ipairs(next_world.nests) do mark(item.pos,ui.colors.gold) end
        for _,item in ipairs(preview.cysts) do mark(item.pos,Interface.color("ca96e4")) end
        mark(next_world.boss_pos,ui.colors.red)
        mark(next_world.start,ui.colors.mint)
        ui:text(1090,766,"Среда · "..next_world:condition_name(1).." / "..next_world:condition_name(2),.88,ui.colors.dim,990)
        ui:text(1090,688,("Цисты · редкие %d · эпические %d · легендарные %d"):format(counts[1],counts[2],counts[3]),.86,ui.colors.gold,990)
        ui:text(1090,609,"Главная угроза · "..sim:boss_title(stage,seed),1.0,ui.colors.gold,990)
        ui:text(1090,538,("%s · %s · %.0f HP"):format(attack.name,attack.hint,1600*(1+.14*(stage-1))),.86,ui.colors.dim,990)
        local mini=sim:stage_miniboss_target(stage)
        ui:text(1090,467,("Гнёзда %d · минибоссы %d · затем босс"):format(math.min(4,mini*2),mini),.89,ui.colors.dim)
        local combo=sim.build:active_synergies()[1]
        if combo then ui:text(1090,400,"Синергия · "..Catalog.SYNERGIES[combo].name,.87,ui.colors.mint,990) end
        ui:button(893,294,660,101,"Продолжить эволюцию",function()
            local ok,err=StageRewards.enter_next_stage(self.store,sim,next_world)
            if ok then self:show_run() else self:notice(err or self.store.last_error) end
        end,true)
        local cost=StageRewards.stage_reroll_cost(sim.stage_index)
        ui:button(1566,294,640,101,"Переброс · "..cost.." органиума",function()
            local ok,err=StageRewards.reroll_stage_area(self.store,sim)
            if ok then self:stage_transition() else self:notice(err or self.store.last_error) end
        end)
    end
end

function App:finish()
    self.sim:flush_family_materials()
    self:process_events()
    self:save_run()
    self:overlay("finish")
    local ui,sim=self.modal,self.sim
    ui:panel("Поколение завершено",string.format("Уровень %d  ·  Ступень %d",sim.level,sim.stage_index))
    ui:button(1230,545,760,106,"Сохранить наследие",function()
        if self.store:finish_run(sim) then
            self.sim=nil
            self:show_home()
        else self:notice(self.store.last_error) end
    end,true)
end

function App:process_events()
    local sim = self.sim
    if #sim.events==0 then return end
    local profile = self.store.profile
    local next_profile = {}
    for key,value in pairs(profile) do next_profile[key]=value end
    local changed=false
    next_profile.credited={}
    for i,token in ipairs(profile.credited or {}) do next_profile.credited[i]=token end
    local credited={}
    for _,token in ipairs(next_profile.credited) do credited[token]=true end
    local materials={}
    for key,value in pairs(profile.organ_materials or {}) do materials[key]=value end
    next_profile.organ_materials=materials
    for _,event in ipairs(sim.events) do
        if event.type=="message" then self:notice(event.text) end
        if event.token and not credited[event.token] then
            if event.type=="core" then
                next_profile.cores=(next_profile.cores or 0)+event.amount
                self:notice("Ядра наследия +"..event.amount)
            elseif event.type=="organium" then
                next_profile.organium=(next_profile.organium or 0)+event.amount
            elseif event.type=="family_material" then
                for key,value in pairs(event.materials) do materials[key]=(materials[key] or 0)+value end
            elseif event.type=="stage_clear" then
                next_profile.best_stage=math.max(next_profile.best_stage or 0,event.stage)
                sim.best_stage=next_profile.best_stage
                next_profile.organium=(next_profile.organium or 0)+StageRewards.stage_reroll_cost(event.stage)
            elseif event.type=="expansion" then
                local state=Equipment.from_profile(next_profile)
                local key=event.target=="stock" and "stock_capacity" or "body_capacity"
                state[key]=state[key]+(event.amount or 1)
                next_profile.organism=state
                sim.stock_capacity=state.stock_capacity
                sim.build.organ_capacity=state.body_capacity
            end
            next_profile.credited[#next_profile.credited+1]=event.token
            credited[event.token]=true
            changed=true
        end
    end
    if changed then
        local events=sim.events
        sim.events={}
        next_profile.checkpoint=sim:snapshot()
        if not self.store:write_profile(next_profile) then
            sim.events=events
            return self:notice(self.store.last_error)
        end
    else sim.events={} end
end

function App:drive()
    local keys = self.keys
    local dx=(keys.right and 1 or 0)-(keys.left and 1 or 0)
    local dy=(keys.down and 1 or 0)-(keys.up and 1 or 0)
    local stick = self.stick
    if stick then return bounded_direction(stick.x-stick.ox,stick.oy-stick.y,94) end
    return bounded_direction(dx,dy,1)
end

function init(self)
    msg.post(".","acquire_input_focus")
    local app=setmetatable({},App)
    self.app=app
    local smoke=sys.get_config_string("microgen.smoke_run","0")=="1"
    app.store=Save.new(smoke and "native_smoke" or nil)
    app.store:load_profile()
    app.audio=Audio.new()
    app.audio_enabled=app.store.profile.audio_enabled~=false
    app.show_metrics=app.store.profile.show_metrics~=false
    app.diag=Diagnostics.new()
    app.driver=graphics.get_adapter_info().family or "GPU"
    app.scene=Scene.new(Tissue.load_atlas())
    app.hud=Interface.new()
    app.hud.group="hud"
    app.modal=Interface.new()
    app.fixed=Interface.new()
    app.fixed.group="feedback"
    app.toast=app.fixed:text(82,145,"",.81,app.fixed.colors.pale,1510)
    app.toast_time=0
    app.stick_base=app.fixed:box(0,0,172,172,vmath.vector4(.16,.56,.58,.35))
    app.stick_tip=app.fixed:box(0,0,64,64,vmath.vector4(.55,1,.87,.68))
    for _,node in ipairs({app.stick_base,app.stick_tip}) do
        gui.set_texture(node,"cells")
        gui.play_flipbook(node,"shield")
    end
    app.cover=gui.new_box_node(vmath.vector3(1230,540,0),vmath.vector3(WIDTH,HEIGHT,0))
    gui.set_layer(app.cover,"water")
    gui.set_texture(app.cover,"world")
    gui.play_flipbook(app.cover,"terrain")
    app.focused=true
    app.updater=Updater.new(sys.get_config_string("project.version","0.4.0"), microgen_updater,
        not smoke and microgen_updater~=nil, function()
            if app.screen=="updates" then app:updates()
            elseif app.screen=="home" and app.updater.state=="ready" then app:show_home() end
        end)
    app:show_home()
    print("MICROGEN PREVIEW READY "..app.driver)
    window.set_listener(function(_,event)
        if event==window.WINDOW_EVENT_FOCUS_GAINED then app.focused=true end
        if event==window.WINDOW_EVENT_FOCUS_LOST then
            app.focused=false
            app:clear_pointer()
            if app.sim and app.screen=="run" then app:pause() end
        end
    end)
    if smoke then
        if #app.store:family_summaries()==0 then
            app.home_slot=3
            app:show_home()
            assert(app.home_slot==3 and app.screen=="home")
            assert(app.store:create_family("Первый забег","predator"))
            assert(app.store:create_family("Второй забег","predator"))
            app.home_slot=nil
            app:show_home()
            assert(app.home_slot==2 and app.screen=="home")
        end
        app:start(47)
    end
    if smoke and sys.get_config_string("microgen.smoke_cards","0")=="1" then
        local sim=app.sim
        sim.level,sim.pending_levels=10,1
        sim.build.biomass=108
        sim.current_offers={"enzymes","barrier","armor"}
        sim.offer_quality={enzymes=2}
        app:body(true)
        assert(app.screen=="build")
        app:body(false)
        assert(app.screen=="preparation")
        app:show_run()
        print("MICROGEN ORGANISM PANEL READY")
        app.scene:render(sim)
        local labels=app.scene.labels
        local tint=vmath.vector4(1,.5,.5,1)
        app.scene:draw_number(sim.player,"6",tint,1)
        app.scene:draw_number(sim.player,"Враждебная амёба · споры",tint,1)
        assert(labels.count==2 and labels.slots[1].enabled and labels.slots[2].enabled)
        app:notice("Враждебная амёба · споры")
        app:level_up()
        assert(labels.layer=="world_labels" and labels.count==0
            and not labels.slots[1].enabled and not labels.slots[2].enabled
            and gui.get_text(app.toast)=="")
        app.scene:draw_number(sim.player,"+0.2",tint,1)
        assert(labels.count==0)
        app:show_run()
        app.scene:draw_number(sim.player,"6",tint,1)
        assert(labels.count==1 and labels.slots[1].enabled)
        app:level_up()
        print("MICROGEN MUTATION CARDS READY")
    end
end

function update(self,dt)
    local app=self.app
    app.updater:step(dt, app.focused and (app.screen=="home" or app.screen=="updates"))
    local fps,p95=app.diag:step()
    if fps then
        if not app.sampled then print("MICROGEN PREVIEW SAMPLE "..app.driver);app.sampled=true end
        if app.metrics and app.sim and app.show_metrics then
            gui.set_text(app.metrics,string.format("%.0f FPS  ·  95%% кадров ≤ %.1f мс  ·  %s",fps,p95,app.driver))
        end
    end
    if app.screen=="briefing_roll" then
        local state=app.briefing
        state.time=state.time+dt
        local fraction=math.min(1,state.time/1.42)
        local step=math.floor(16*(1-(1-fraction)^2))
        if step~=state.step then
            state.step=step
            gui.set_text(state.caption,app.sim:stage_name(state.stage,state.seed+step))
        end
        local zoom=.75+.24*fraction+.05*math.sin(state.time*18)
        gui.set_scale(state.dial,vmath.vector3(zoom,zoom,1))
        gui.set_rotation(state.dial,vmath.vector3(0,0,fraction*245))
        if fraction>=1 then app.briefing=nil;app:stage_transition() end
    end
    if app.screen=="reveal" then
        local state=app.reveal
        state.time=state.time+dt
        local fraction=math.min(1,state.time/2.6)
        local step=math.floor(24*(1-(1-fraction)^2.4))
        if step~=state.step then
            state.step=step
            for i,icon in ipairs(state.icons) do
                local ids=Catalog.ORGAN_IDS
                gui.play_flipbook(icon,"icon_"..ids[(step*7+i*3)%#ids+1])
            end
        end
        local scale=.72+fraction*.52+.04*math.sin(state.time*18)
        gui.set_scale(state.core,vmath.vector3(scale,scale,1))
        gui.set_rotation(state.core,vmath.vector3(0,0,fraction*145))
        local open=math.min(1,math.max(0,(state.time-.9)))
        open=open*open*(3-2*open)
        local sway=5*math.sin(state.time*19)*(1-open)
        gui.set_position(state.shell_left,vmath.vector3(1150-open*100+sway,589+open*19,0))
        gui.set_position(state.shell_right,vmath.vector3(1310+open*100+sway,589-open*11,0))
        gui.set_rotation(state.shell_left,vmath.vector3(0,0,open*20))
        gui.set_rotation(state.shell_right,vmath.vector3(0,0,-open*20))
        gui.set_color(state.inner,vmath.vector4(state.palette.x,state.palette.y,state.palette.z,open))
        gui.set_scale(state.inner,vmath.vector3(scale,scale,1))
        if state.time>=1.7 and not state.opened then
            state.opened=true
            gui.set_text(state.text,state.caption.." · мутации сформированы")
        end
        if fraction>=1 then app:reward(true) end
    end
    if app.toast_time>0 then
        app.toast_time=app.toast_time-dt
        if app.toast_time<=0 then gui.set_text(app.toast,"") end
    end
    local sim=app.sim
    if not sim then
        if app.home_world and app.screen=="home" and app.focused then
            app.home_delta=(app.home_delta or 0)+dt
            if app.home_delta>=1/30 then
                app.home_world.elapsed=app.home_world.elapsed+math.min(.1,app.home_delta)
                app.home_delta=0
                app.scene:render(app.home_world)
            end
        end
        return
    end
    if app.screen=="run" then
        local dx,dy=app:drive()
        local rewards_before=#sim.reward_queue
        sim:step(math.min(.1,dt),dx,dy)
        if #sim.reward_queue>rewards_before then app.deferred_choices=false end
        app:process_events()
        if sim.stage_transition then app.breakup_time=(app.breakup_time or 0)+dt end
        app.scene:render(sim,app.breakup_time)
        app.hud_timer=(app.hud_timer or 0)+dt
        if app.hud_timer>.10 then app.hud_timer=0;app:draw_hud() end
        app.save_time=app.save_time+dt
        if app.save_time>=12 then app.save_time=0;app:save_run() end
        if sim.outcome and sim.outcome~="" then app:finish()
        elseif sim.stage_transition then
            if app.breakup_time>=1.35 then app.breakup_time=nil;app:stage_transition() end
        elseif not app.deferred_choices and (#sim.reward_queue>0 or #sim.pending_inventory>0 or sim.pending_levels>0) then
            app:open_pending()
        end
        local pending=#sim.reward_queue+#sim.pending_inventory+sim.pending_levels
        if pending>0 and app.screen=="run" then
            if not app.reward_button then
                app.reward_button=app.hud:button(app.reward_x,app.reward_y,288,81,"",function() app:open_pending() end,true)
            end
            gui.set_text(app.reward_button.text,string.format("Награда · %d",pending))
            Interface.button_enabled(app.reward_button,true)
        elseif app.screen=="run" and app.reward_button then Interface.button_enabled(app.reward_button,false) end
    end
    app.audio:consume(sim,app.audio_enabled,app.screen~="run")
    sim.feedback={}
end

local function pointer(app,id,x,y,pressed,released)
    if pressed and app.touch_id==nil then
        app.touch_id=id
        app.press_action=app.modal:hit(x,y) or (app.screen=="run" and app.hud:hit(x,y))
        if not app.press_action and app.screen=="run" then app.stick={ox=x,oy=y,x=x,y=y} end
    end
    if app.touch_id~=id then return end
    if released then
        local chosen=app.press_action
        local over=app.modal:hit(x,y) or (app.screen=="run" and app.hud:hit(x,y))
        app:clear_pointer()
        if chosen and over==chosen then chosen() end
    elseif app.stick then
        local stick=app.stick
        stick.x,stick.y=x,y
        local dx,dy=bounded_direction(x-stick.ox,y-stick.oy,94)
        gui.set_position(app.stick_base,vmath.vector3(stick.ox,stick.oy,0))
        gui.set_position(app.stick_tip,vmath.vector3(stick.ox+dx*57,stick.oy+dy*57,0))
        gui.set_enabled(app.stick_base,true)
        gui.set_enabled(app.stick_tip,true)
    end
end

function on_input(self,id,action)
    local app=self.app
    if action.pressed and app.screen=="run" then
        if id==hash("map") then app:map();return true end
        if id==hash("build") then app.development_origin=nil;app:body(true);return true end
        if id==hash("colony") then
            local index=app.sim:nearby_colony()
            if index>0 then app:colony(index) end
            return true
        end
    end
    local direction=DIRECTIONS[id]
    if direction then
        if action.pressed then app.keys[direction]=true end
        if action.released then app.keys[direction]=nil end
        return true
    end
    if id==hash("back") and action.pressed then
        if app.screen=="run" then app:pause()
        elseif app.screen=="pause" then app:show_run()
        elseif app.close_current then app.close_current()
        elseif app.sim and (app.screen=="build" or app.screen=="map" or app.screen=="colony") then app:show_run()
        elseif not app.sim then app:show_home() end
        return true
    end
    if id==hash("touch") and action.touch then
        for _,point in ipairs(action.touch) do
            pointer(app,point.id,point.x,point.y,point.pressed,point.released)
        end
        return true
    end
    if id==hash("pointer") then
        pointer(app,"mouse",action.x,action.y,action.pressed,action.released)
        return true
    end
end

function final(self)
    local app=self.app
    if app and app.sim and app.screen~="home" then app:save_run() end
    if app then app.audio:stop() end
end
