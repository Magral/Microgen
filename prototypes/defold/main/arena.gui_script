local ARENA = require "main.arena_data"
local WIDTH, HEIGHT = ARENA.size[1], ARENA.size[2]
local SAMPLE_SECONDS, WARMUP_SECONDS = 2, 2
local WORLD_COLOR = vmath.vector4(1, 1, 1, 1)
local PALETTE = {
    enemy_toxin = vmath.vector4(1.0, .39, .52, .85),
    spore = vmath.vector4(.72, .62, 1.0, .64),
    poison = vmath.vector4(.63, .95, .49, .56),
}
local DIRECTION = {up = true, down = true, left = true, right = true}

local function screen_point(point)
    return vmath.vector3(point[1], HEIGHT - point[2], 0)
end

local function box(x, y, w, h, color)
    local node = gui.new_box_node(vmath.vector3(x, y, 0), vmath.vector3(w, h, 0))
    gui.set_color(node, color)
    return node
end

local function sprite(atlas, frame, position, width, height, color)
    local node = box(position.x, position.y, width, height, color or WORLD_COLOR)
    gui.set_texture(node, atlas)
    gui.play_flipbook(node, frame)
    return node
end

local function text(x, y, value, color, scale)
    local node = gui.new_text_node(vmath.vector3(x, y, 0), value)
    gui.set_font(node, "interface")
    gui.set_pivot(node, gui.PIVOT_W)
    gui.set_color(node, color)
    gui.set_scale(node, vmath.vector3(scale, scale, 1))
    return node
end

function init(self)
    msg.post(".", "acquire_input_focus")
    local world = ARENA
    self.world = world
    self.elapsed = 0
    self.position = screen_point(world.player.pos)
    self.keys = {}
    self.pointer = nil
    self.touch_id = nil
    self.frames = {}
    self.window_time = 0
    self.last_tick = socket.gettime()
    self.driver = graphics.get_adapter_info().family or "GPU"
    sprite("world", "terrain", vmath.vector3(WIDTH / 2, HEIGHT / 2, 0), WIDTH, HEIGHT)
    self.fields = {}
    for i, field in ipairs(world.fields) do
        local color = assert(PALETTE[field.kind])
        local radius = field.radius
        self.fields[i] = sprite("cells", "field", screen_point(field.pos), radius * 2.45, radius * 2.45, color)
    end
    self.pickups = {}
    for i, item in ipairs(world.pickups) do
        local tint = item.kind == "heal" and vmath.vector4(.92, 1, .46, 1) or WORLD_COLOR
        self.pickups[i] = sprite("cells", "speck", screen_point(item.pos), 27, 27, tint)
    end
    self.actors = {}
    for i, actor in ipairs(world.actors) do
        local diameter = actor.radius * 2.60
        self.actors[i] = sprite("cells", actor.kind, screen_point(actor.pos), diameter, diameter)
    end
    local diameter = world.player.radius * 2.60
    self.player = sprite("cells", "player", self.position, diameter, diameter)
    self.surge = sprite("cells", "surge", self.position, diameter * 2.5, diameter * 2.5, vmath.vector4(.66,1,.40,.45))
    self.shield = sprite("cells", "shield", self.position, diameter * 1.28, diameter * 1.28, vmath.vector4(.57,.94,1,.48))

    box(405,955,722,166,vmath.vector4(.021,.075,.105,.86))
    box(47,955,5,166,vmath.vector4(.41,.91,.75,1))
    text(74, 1000, "МИКРОГЕН  ·  DEFOLD", vmath.vector4(.63,1,.86,1), 1.08)
    text(74, 952, world.stage_name .. "  ·  Ступень 4", vmath.vector4(.92,.98,.94,1), .91)
    text(74, 905, string.format("%d организмов  ·  %d полей  ·  Зерно %d", #world.actors + 1, #world.fields, world.seed),
        vmath.vector4(.65,.82,.81,1), .76)
    box(WIDTH/2,44,WIDTH-90,64,vmath.vector4(.021,.075,.105,.91))
    self.metric = text(70,44,"Прогрев сцены",vmath.vector4(.68,.98,.90,1),.92)
    text(1740,44,"Касание или WASD · движение",vmath.vector4(.67,.82,.81,1),.74)
    print("MICROGEN PREVIEW READY " .. self.driver)
end

local function movement(self)
    local keys = self.keys
    local dx = (keys.right and 1 or 0) - (keys.left and 1 or 0)
    local dy = (keys.up and 1 or 0) - (keys.down and 1 or 0)
    if self.pointer then
        dx, dy = self.pointer.x - self.position.x, self.pointer.y - self.position.y
    end
    local distance = math.sqrt(dx*dx + dy*dy)
    if distance < .001 or (self.pointer and distance < 12) then return 0, 0 end
    return dx/distance, dy/distance
end

local function measure(self)
    local now = socket.gettime()
    local frame = now - self.last_tick
    self.last_tick = now
    if self.elapsed < WARMUP_SECONDS or frame <= 0 then return end
    self.window_time = self.window_time + frame
    self.frames[#self.frames + 1] = frame
    if self.window_time < SAMPLE_SECONDS then return end
    table.sort(self.frames)
    local count = #self.frames
    local p95 = self.frames[math.ceil(count*.95)] * 1000
    local width, height = window.get_size()
    gui.set_text(self.metric, string.format("%.0f FPS  ·  95%% кадров ≤ %.1f мс  ·  %d×%d  ·  %s",
        count / self.window_time, p95, width, height, self.driver))
    if not self.sample_logged then
        print("MICROGEN PREVIEW SAMPLE " .. self.driver)
        self.sample_logged = true
    end
    self.window_time = 0
    self.frames = {}
end

function update(self, dt)
    local t = self.elapsed + math.min(dt,.10)
    self.elapsed = t
    local dx, dy = movement(self)
    local step = math.min(dt,.06)*265
    self.position.x = math.max(120, math.min(WIDTH-120, self.position.x + dx*step))
    self.position.y = math.max(115, math.min(HEIGHT-115, self.position.y + dy*step))
    gui.set_position(self.player, self.position)
    gui.set_position(self.surge, self.position)
    gui.set_position(self.shield, self.position)
    if dx~=0 or dy~=0 then gui.set_rotation(self.player, vmath.vector3(0,0,math.deg(math.atan2(dy,dx)))) end
    gui.set_scale(self.player, vmath.vector3(1+.045*math.sin(t*2.4), 1-.038*math.sin(t*2.4), 1))
    gui.set_rotation(self.surge, vmath.vector3(0,0,t*16))
    local swell = 1+.12*math.sin(t*2.2)
    gui.set_scale(self.surge, vmath.vector3(swell,swell,1))
    gui.set_rotation(self.shield, vmath.vector3(0,0,-t*9))
    for i, actor in ipairs(self.world.actors) do
        local phase = actor.phase + t * (actor.kind=="boss" and .70 or 1.1)
        local node = self.actors[i]
        gui.set_position(node, vmath.vector3(actor.pos[1]+14*math.cos(phase), HEIGHT-actor.pos[2]+12*math.sin(phase),0))
        gui.set_rotation(node, vmath.vector3(0,0,22*math.sin(phase)))
        gui.set_scale(node, vmath.vector3(1+.07*math.sin(phase*1.7),1-.06*math.sin(phase*1.7),1))
    end
    for i, node in ipairs(self.fields) do
        local s = 1+.06*math.sin(t*1.7+i*.73)
        gui.set_scale(node, vmath.vector3(s,s,1))
        gui.set_rotation(node, vmath.vector3(0,0,t*5+i*29))
    end
    for i, pickup in ipairs(self.world.pickups) do
        gui.set_position(self.pickups[i],vmath.vector3(pickup.pos[1],HEIGHT-pickup.pos[2]+3*math.sin(t*2+pickup.phase),0))
    end
    measure(self)
end

function on_input(self, id, action)
    for key in pairs(DIRECTION) do
        if id == hash(key) then
            if action.pressed then self.keys[key] = true end
            if action.released then self.keys[key] = nil end
            return true
        end
    end
    if id == hash("touch") and action.touch then
        for _, point in ipairs(action.touch) do
            if point.pressed and self.touch_id == nil then self.touch_id = point.id end
            if self.touch_id == point.id then
                if point.released then
                    self.touch_id, self.pointer = nil, nil
                else
                    self.pointer = vmath.vector3(point.x, point.y, 0)
                end
            end
        end
        return true
    end
    if id == hash("pointer") then
        if self.touch_id ~= nil then return true end
        self.pointer = not action.released and vmath.vector3(action.x,action.y,0) or nil
        return true
    end
end
