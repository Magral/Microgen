name: "liquid"
tags: "gui"
vertex_program: "/main/liquid.vp"
fragment_program: "/main/liquid.fp"
vertex_space: VERTEX_SPACE_WORLD
vertex_constants {
  name: "view_proj"
  type: CONSTANT_TYPE_VIEWPROJ
}
vertex_constants {
  name: "fluid_view"
  type: CONSTANT_TYPE_USER
  value { x: 0.0 y: 0.0 z: 2460.0 w: 1080.0 }
}
vertex_constants {
  name: "fluid_stage"
  type: CONSTANT_TYPE_USER
  value { x: 0.0 y: 0.0 z: 2860.0 w: 0.0 }
}
fragment_constants {
  name: "fluid_view"
  type: CONSTANT_TYPE_USER
  value { x: 0.0 y: 0.0 z: 2460.0 w: 1080.0 }
}
fragment_constants {
  name: "fluid_stage"
  type: CONSTANT_TYPE_USER
  value { x: 0.0 y: 0.0 z: 2860.0 w: 0.0 }
}
samplers {
  name: "texture_sampler"
  wrap_u: WRAP_MODE_REPEAT
  wrap_v: WRAP_MODE_REPEAT
  filter_min: FILTER_MODE_MIN_LINEAR
  filter_mag: FILTER_MODE_MAG_LINEAR
}
max_page_count: 0
