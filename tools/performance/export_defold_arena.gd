extends SceneTree

const Fixture = preload("res://tools/performance/defold_fixture.gd")

func _initialize():
	var output = FileAccess.open("res://prototypes/defold/main/arena.json", FileAccess.WRITE)
	if output == null:
		push_error("Unable to write the shared fixture")
		quit(1)
		return
	var data = Fixture.describe(Fixture.make())
	var fixture_json = JSON.stringify(data, "\t") + "\n"
	output.store_string(fixture_json)
	var runtime = FileAccess.open("res://prototypes/defold/main/arena_data.lua", FileAccess.WRITE)
	if runtime == null:
		push_error("Unable to write the Defold fixture resource")
		quit(1)
		return
	runtime.store_string("-- Generated by tools/performance/export_defold_arena.gd.\nreturn json.decode([==[\n" + fixture_json + "]==])\n")
	print("Arena seed %s: %d actors, %d fields, %d wall tiles" % [data.seed,data.actors.size(),data.fields.size(),data.walls.size()])
	quit()
